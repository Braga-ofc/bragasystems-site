---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Topo from "../components/sections/Topo.astro";
import Rodape from "../components/sections/Rodape.astro";
import CamadaViva from "../components/ui/CamadaViva.astro";
import Cookies from "../components/ui/Cookies.astro";
import { estadoDe } from "../lib/supabase";

interface Props {
  titulo: string;
  descricao?: string;
  /** Páginas que não devem aparecer no Google (obrigado, briefing, 404, amostra). */
  semIndexar?: boolean;
  /** Topo fixo e rodapé do site. A página /amostra usa a própria moldura. */
  moldura?: boolean;
  /**
   * Só nas páginas com o contador de vagas: o número lido no build (ou null, se não deu para ler).
   * Liga os estados do contador (<html data-vagas-estado>). A página importa scripts/contador.
   */
  vagasBuild?: number | null;
  /** Compartilhamento (Open Graph). Sem ele, a página usa o próprio título e descrição. */
  og?: { titulo: string; descricao: string; imagem?: string; imagemAlt?: string };
}
const {
  titulo,
  descricao = "Sites e landing pages personalizados, com copy de conversão inclusa, para negócios que vendem serviços de alto valor e fecham pelo WhatsApp.",
  semIndexar = false,
  moldura = true,
  vagasBuild,
  og = { titulo, descricao },
} = Astro.props;

const temContador = vagasBuild !== undefined;
// Endereço oficial (mapa técnico 10): o canonical e o og apontam para o domínio, não para o link de teste
// Com build.format "file", as páginas são montadas como /pagina.html (e a home como /index.html): o
// canonical usa o endereço que o site mostra e o sitemap lista, sem ".html" (e a home na raiz)
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/(^|\/)index$/, "$1"), Astro.site).href;
// Toda página compartilhada leva uma imagem: sem uma própria, vai a da home (antes, só a home tinha)
const ogImagem = new URL(og.imagem ?? compartilhar.imagem, Astro.site).href;
const ogImagemAlt = og.imagem ? og.imagemAlt : compartilhar.imagemAlt;
import { compartilhar } from "../content/home";
---
<!doctype html>
<html
  lang="pt-BR"
  data-vagas-estado={temContador ? estadoDe(vagasBuild) : undefined}
  data-vagas-build={temContador && vagasBuild !== null ? String(vagasBuild) : undefined}
  data-vagas-n={temContador && vagasBuild !== null ? String(vagasBuild) : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {semIndexar ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="BRAGA SYSTEMS" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={og.titulo} />
    <meta property="og:description" content={og.descricao} />
    {ogImagem && (
      <>
        <meta property="og:image" content={ogImagem} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {ogImagemAlt && <meta property="og:image:alt" content={ogImagemAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B0F14" />
    <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {/*
      Seções fora da tela não são desenhadas na entrada (global.css: content-visibility). Para os links
      com âncora (menu, "Ver os planos") caírem no lugar certo, todas são desenhadas antes da rolagem:
      ao chegar com # no endereço ou ao clicar num link # desta página (fase de captura, antes do Lenis).
    */}
    <script is:inline>
      (function () {
        var r = document.documentElement;
        var todas = function () { r.classList.add("secoes-todas"); };
        if (location.hash) todas();
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest && e.target.closest("a[href*='#']");
          if (a && a.hash && a.pathname === location.pathname) todas();
        }, true);
        addEventListener("hashchange", todas);
      })();
    </script>
  </head>
  <body>
    {moldura && <CamadaViva />}
    {moldura && <Topo />}
    <slot />
    {moldura && <Rodape />}
    {moldura && <Cookies />}
    <script>
      // Animações infinitas só rodam à vista e depois da carga (precisa rodar cedo, para pausar antes da carga)
      import "../scripts/animacoes";
      // Medidor de fluidez para testar no celular de verdade: liga com ?fps ou #fps no endereço
      // e continua ligado nas próximas páginas da mesma aba
      let fps = /fps/i.test(location.search + location.hash);
      try {
        if (fps) sessionStorage.setItem("braga-fps", "1");
        else fps = sessionStorage.getItem("braga-fps") === "1";
      } catch {}
      if (fps) import("../scripts/diagnostico");
      // Fora da primeira tela: liga depois que o hero começou a entrar, sem travar a abertura
      import { depois } from "../scripts/depois";
      depois(() => {
        import("../scripts/revela");
        import("../scripts/rolagem");
        import("../scripts/marca-texto");
      });
    </script>
  </body>
</html>
