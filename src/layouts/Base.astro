---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Topo from "../components/sections/Topo.astro";
import Rodape from "../components/sections/Rodape.astro";
import CamadaViva from "../components/ui/CamadaViva.astro";
import { estadoDe } from "../lib/supabase";

interface Props {
  titulo: string;
  descricao?: string;
  /** Páginas que não devem aparecer no Google (obrigado, briefing, 404, amostra). */
  semIndexar?: boolean;
  /** Topo fixo e rodapé do site. A página /amostra usa a própria moldura. */
  moldura?: boolean;
  /**
   * Só nas páginas com o contador de vagas: o número lido no build (ou null, se não deu para ler).
   * Liga os estados do contador (<html data-vagas-estado>). A página importa scripts/contador.
   */
  vagasBuild?: number | null;
}
const {
  titulo,
  descricao = "Sites e landing pages personalizados, com copy de conversão inclusa, para negócios que vendem serviços de alto valor e fecham pelo WhatsApp.",
  semIndexar = false,
  moldura = true,
  vagasBuild,
} = Astro.props;

const temContador = vagasBuild !== undefined;
---
<!doctype html>
<html
  lang="pt-BR"
  data-vagas-estado={temContador ? estadoDe(vagasBuild) : undefined}
  data-vagas-build={temContador && vagasBuild !== null ? String(vagasBuild) : undefined}
  data-vagas-n={temContador && vagasBuild !== null ? String(vagasBuild) : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {semIndexar && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B0F14" />
    <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {moldura && <CamadaViva />}
    {moldura && <Topo />}
    <slot />
    {moldura && <Rodape />}
    <script>
      import "../scripts/revela";
      import "../scripts/rolagem";
      import "../scripts/marca-texto";
    </script>
  </body>
</html>
