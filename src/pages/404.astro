---
import Base from "../layouts/Base.astro";
import { montarLinkWhatsapp } from "../lib/whatsapp";
---
<Base titulo="Página não encontrada | BRAGA SYSTEMS">
  <main style="min-height:100svh;display:grid;place-content:center;gap:20px;padding:24px;max-width:560px;margin:0 auto">
    <h1 style="font-family:'Space Grotesk',system-ui,sans-serif;margin:0">Essa página não existe (ainda).</h1>
    <p style="margin:0;color:#8A96A6">O endereço pode estar errado ou a página mudou de lugar.</p>
    <p style="margin:0;display:flex;gap:16px;flex-wrap:wrap">
      <a href="/" style="color:#35D5E8">Voltar para o início</a>
      <a href={montarLinkWhatsapp("topo")} style="color:#35D5E8">Falar no WhatsApp</a>
    </p>
  </main>
</Base>
<style>:global(body){margin:0;background:#0B0F14;color:#D6DDE6;font-family:"Inter",system-ui,sans-serif}</style>
