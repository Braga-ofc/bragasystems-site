---
// Home de venda (copy oficial §1 a §18). Topo e rodapé vêm do layout Base.
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import Gerador from "../components/sections/Gerador.astro";
import Dor from "../components/sections/Dor.astro";
import Proposta from "../components/sections/Proposta.astro";
import Metodo from "../components/sections/Metodo.astro";
import Beneficios from "../components/sections/Beneficios.astro";
import Projetos from "../components/sections/Projetos.astro";
import Planos from "../components/sections/Planos.astro";
import Processo from "../components/sections/Processo.astro";
import Objecoes from "../components/sections/Objecoes.astro";
import Garantia from "../components/sections/Garantia.astro";
import Sobre from "../components/sections/Sobre.astro";
import Urgencia from "../components/sections/Urgencia.astro";
import Faq from "../components/sections/Faq.astro";
import CtaFinal from "../components/sections/CtaFinal.astro";
import Ps from "../components/sections/Ps.astro";
import { lerVagasNoBuild, vagasMax } from "../lib/supabase";
import { Image } from "astro:assets";
import fotoGustavo from "../assets/gustavo/gustavo-braga-sentado-hd.jpg";
import { hero } from "../content/home";

// Número de vagas do último build: a página já carrega com ele (mapa técnico, arquivo 03).
const vagasBuild = await lerVagasNoBuild();
const vagas = vagasBuild ?? vagasMax;
---
<Base titulo="BRAGA SYSTEMS — Sites e landing pages de alta conversão" vagasBuild={vagasBuild}>
  <main id="conteudo">
    <div class="abertura">
      <canvas class="abertura__nevoa" aria-hidden="true" data-nevoa></canvas>
      <span class="abertura__linha" aria-hidden="true"></span>
      <span class="abertura__grade-luz" aria-hidden="true" data-grade-luz></span>
      <Hero vagas={vagas} />
      <figure class="abertura__retrato">
        <Image
          class="abertura__foto"
          src={fotoGustavo}
          alt={hero.retrato.alt}
          widths={[360, 480, 720, 960]}
          sizes="(min-width: 1024px) 460px, min(360px, 90vw)"
          format="avif"
          quality={70}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="abertura__legenda">{hero.retrato.legenda}</figcaption>
      </figure>
      <Gerador />
    </div>
    <Dor />
    <Sobre />
    <Proposta />
    <Metodo />
    <Beneficios />
    <Projetos vagas={vagas} />
    <Planos />
    <Processo />
    <Objecoes />
    <Garantia />
    <Urgencia vagas={vagas} />
    <Faq />
    <CtaFinal />
    <Ps vagas={vagas} />
  </main>
</Base>

<script>
  import "../scripts/contador";
  import "../scripts/nevoa";
  import { depois } from "../scripts/depois";
  depois(() => import("../scripts/grade-luz"));
</script>

<style>
  /*
    Primeira dobra: Hero e Gerador dividem a mesma faixa sobre a névoa (a grade saiu em 19/10/2026).
    Celular: empilhados. A partir de 1024 px: 12 colunas, a oferta em 1–7 e o console em 8–12,
    alinhados ao topo; cabe em 1440×900 com o topo de 72 px.
  */
  .abertura {
    --borda-lateral: max(var(--gutter), (100% - var(--largura-max)) / 2);
    position: relative;
    isolation: isolate;
    /* Corta nos dois eixos: a luz da grade (360 px) não vaza para a Dor */
    overflow: clip;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
    /* Topo em múltiplo de 32 px: o conteúdo começa numa linha da grade */
    padding: var(--s-8) var(--borda-lateral) var(--secao-respiro);
  }

  /*
    Grade de pontos a cada 32 px (versão leve, 19/10/2026): CSS parado, que se dissolve nas bordas e
    some antes do fim da dobra, para a passagem até a Dor continuar sem corte. A primeira coluna cai
    na margem do conteúdo. Com mouse, scripts/grade-luz.ts acende os pontos em volta do cursor.
  */
  .abertura::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(circle at 0.875px 0.875px, rgb(74 87 104 / 0.85) 0.875px, transparent 1.4px);
    background-size: 32px 32px;
    /* Em background-position, 100% desconta a largura do ladrilho: daí os 32px de volta */
    background-position: max(var(--gutter), (100% - var(--largura-max) + 32px) / 2) 0;
    -webkit-mask-image: radial-gradient(ellipse 120% 52% at 20% 0%, black 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 120% 52% at 20% 0%, black 30%, transparent 100%);
  }
  .abertura__grade-luz {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 360px;
    height: 360px;
    pointer-events: none;
    background-image: radial-gradient(circle at 1px 1px, rgb(53 213 232 / 0.95) 1.1px, transparent 1.7px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(closest-side, black, transparent);
    mask-image: radial-gradient(closest-side, black, transparent);
    opacity: 0;
    transition: opacity 400ms var(--ease-saida);
    will-change: transform;
  }
  .abertura__grade-luz[data-ligada] { opacity: 0.9; }
  @media (forced-colors: active) {
    .abertura::before, .abertura__grade-luz { display: none; }
  }

  /*
    Névoa (scripts/nevoa.ts): luz viva atrás da grade, que acende devagar quando o primeiro quadro
    fica pronto. Sem WebGL ela nunca acende e a dobra fica só com a grade.
  */
  .abertura__nevoa {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1200ms var(--ease-saida);
    /* Esmaece no fim da dobra: a primeira dobra se funde com a Dor, sem corte */
    -webkit-mask-image: linear-gradient(#000 60%, transparent);
    mask-image: linear-gradient(#000 60%, transparent);
  }
  .abertura__nevoa:global(.is-acesa) { opacity: 1; }
  /* Último recurso, se a foto da névoa não carregar: o mesmo núcleo de luz, parado, em gradientes */
  .abertura:global(.is-estatica) {
    background:
      radial-gradient(ellipse 40% 45% at 85% 22%, rgb(11 124 140 / 0.3), transparent 70%),
      radial-gradient(ellipse 65% 55% at 75% 30%, rgb(32 40 51 / 0.7), transparent 75%);
  }
  @media (min-width: 1024px) {
    .abertura:global(.is-estatica) {
      background:
        radial-gradient(ellipse 30% 45% at 56% 40%, rgb(11 124 140 / 0.3), transparent 70%),
        radial-gradient(ellipse 55% 60% at 58% 40%, rgb(32 40 51 / 0.7), transparent 75%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .abertura__nevoa { transition-duration: 1ms; }
  }

  /*
    O rosto de quem atende (copy 2.8): a foto tem fundo preto e se funde com a névoa, sem moldura;
    as bordas somem num degradê. É o maior elemento da primeira tela, então carrega primeiro (AVIF).
    No celular vem logo depois do botão, antes do gerador.
  */
  .abertura__retrato {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 360px;
    justify-self: center;
    min-width: 0;
  }
  /* :global: o <Image> é outro componente e não recebe o escopo deste arquivo */
  .abertura__retrato :global(.abertura__foto) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 18%;
    -webkit-mask-image: radial-gradient(ellipse 50% 46% at 50% 44%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 46% at 50% 44%, #000 62%, transparent 100%);
  }
  .abertura__legenda {
    margin-top: calc(var(--s-7) * -1);
    position: relative;
    text-align: center;
    font: 500 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--ink-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .abertura__retrato { animation: retrato-entra 900ms var(--ease-saida) 250ms backwards; }
  }
  @keyframes retrato-entra {
    from { opacity: 0; translate: 0 16px; }
  }

  /* Começo da linha do site inteiro (a mesma de ui/Secao): nasce no hero e desce até a Dor */
  .abertura { view-timeline: --abertura; }
  .abertura__linha {
    position: absolute;
    top: var(--s-8);
    bottom: 0;
    left: calc(var(--borda-lateral) - min(18px, var(--gutter) * 0.5));
    width: 1px;
    pointer-events: none;
    background: linear-gradient(transparent, rgb(74 87 104 / 0.45) 25%);
  }
  .abertura__linha::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, var(--accent) 25%);
    box-shadow: 0 0 6px rgb(53 213 232 / 0.45);
    transform-origin: top;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .abertura__linha::after {
        animation: abertura-linha linear both;
        animation-timeline: --abertura;
        animation-range: cover 50vh cover calc(100% - 50vh);
      }
    }
  }
  @keyframes abertura-linha { from { transform: scaleY(0); } }
  @media (forced-colors: active) { .abertura__linha { display: none; } }

  @media (min-width: 1024px) {
    .abertura {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--s-5);
      align-items: start;
    }
    .abertura::before {
      -webkit-mask-image: radial-gradient(ellipse 75% 85% at 35% 5%, black 35%, transparent 100%);
      mask-image: radial-gradient(ellipse 75% 85% at 35% 5%, black 35%, transparent 100%);
    }
    .abertura > :global(.hero) { grid-column: 1 / span 7; align-self: center; }
    .abertura__retrato { grid-column: 8 / span 5; max-width: none; justify-self: stretch; }
    /* O gerador desce para a linha de baixo, centrado: o rosto fica com a primeira impressão */
    .abertura > :global(.gerador) { grid-column: 3 / span 8; }
  }
</style>
