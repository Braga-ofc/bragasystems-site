---
// Página provisória até a home completa (§1 a §18) entrar na etapa 3.
import Base from "../layouts/Base.astro";
import Botao from "../components/ui/Botao.astro";
import Selo from "../components/ui/Selo.astro";
import logo from "../assets/logo/logo-horizontal-escuro.svg?raw";
import { montarLinkWhatsapp } from "../lib/whatsapp";
---
<Base titulo="BRAGA SYSTEMS — Sites e landing pages de alta conversão">
  <main class="provisoria">
    <div class="logo" set:html={logo} />
    <Selo />
    <h1>Seu cliente chega no WhatsApp pronto para fechar.</h1>
    <p class="sub">Landing pages e sites personalizados, com copy de conversão inclusa, para negócios que vendem serviços de alto valor e fecham pelo WhatsApp.</p>
    <Botao href={montarLinkWhatsapp("topo")} icone="whatsapp" origem="topo">Falar no WhatsApp</Botao>
  </main>
</Base>

<style>
  .provisoria {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: var(--s-5);
    width: min(100% - 2 * var(--gutter), 680px);
    margin-inline: auto;
    padding-block: var(--s-8);
  }
  .logo { margin-bottom: var(--s-5); }
  .logo :global(svg) { width: min(240px, 64vw); height: auto; }
  h1 { font-size: var(--t-display); line-height: 1.05; letter-spacing: -0.03em; }
  .sub { font-size: var(--t-body-lg); color: var(--ink-muted); max-width: 52ch; }
</style>
