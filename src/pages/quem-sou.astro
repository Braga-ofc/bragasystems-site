      .qs-folio__rotulos li { display: block; }
      .qs-folio__rotulos li {
        position: absolute;
        inset: 0;
        opacity: 0;
        animation-name: qs-rotulo;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--cap);
        animation-range: entry 70% exit 30%;
      }

      /* O B desenhado em traço capítulo a capítulo; a cor entra depois e o traço sai no fim */
      .qs-b {
        stroke: var(--accent);
        stroke-width: 6;
        stroke-dasharray: 1;
        stroke-linejoin: miter;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }
      .qs-b--haste {
        animation-name: qs-traco, qs-preenche, qs-apaga;
        animation-timeline: --cap1, --cap3, --cap6;
        animation-range: entry 60% cover 55%, entry 60% cover 50%, entry 50% cover 45%;
      }
      .qs-b--corpo {
        animation-name: qs-traco, qs-preenche, qs-apaga;
        animation-timeline: --cap2, --cap4, --cap6;
        animation-range: entry 60% cover 60%, cover 10% cover 30%, entry 50% cover 45%;
      }
      .qs-b--nucleo {
        animation-name: qs-traco, qs-preenche, qs-apaga;
        animation-timeline: --cap3, --cap5, --cap6;
        animation-range: entry 80% cover 60%, entry 60% cover 40%, entry 50% cover 45%;
      }
      .qs-b-luz {
        animation-name: qs-acende;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cap5;
        animation-range: cover 35% cover 55%;
      }

      /* 01: o número em paralaxe dentro do próprio capítulo */
      .qs-cap__num {
        animation-name: qs-paralaxe;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover;
      }
      .qs-cap__titulo,
      .qs-cap__texto {
        animation-name: qs-entra;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }

      /* 02: as funções acendem uma a uma */
      .qs-funcoes li {
        animation-name: qs-funcao;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cap2;
        animation-range: cover calc(32% + var(--j) * 8%) cover calc(40% + var(--j) * 8%);
      }

      /* 03: o carimbo cai seco */
      .qs-carimbo {
        animation-name: qs-carimba;
        animation-timing-function: cubic-bezier(0.5, 0, 0.2, 1);
        animation-fill-mode: both;
        animation-timeline: --cap3;
        animation-range: cover 38% cover 46%;
      }

      /* 04: o fundo claro corta de baixo para cima; "código." é riscado e "copy." é marcada */
      .qs-cap--pico::before {
        animation-name: qs-corte;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cap4;
        animation-range: entry 0% entry 45%;
      }
      .qs-virada__risco::after {
        transform-origin: left;
        animation-name: qs-risca;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cap4;
        animation-range: cover 40% cover 50%;
      }
      .qs-virada__linha--2 {
        animation-name: qs-entra;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cap4;
        animation-range: cover 48% cover 56%;
      }
      .qs-virada__copy::before {
        animation-name: qs-marca;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cap4;
        animation-range: cover 56% cover 66%;
      }

      /* 05: o sobrenome desliza atrás do texto */
      .qs-sobrenome {
        animation-name: qs-desliza;
        animation-timing-function: linear;
        animation-fill-mode: both;
