        animation-name: qs-palavra;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cap6;
        animation-range: cover calc(30% + var(--k) * 4%) cover calc(36% + var(--k) * 4%);
      }
    }
  }
