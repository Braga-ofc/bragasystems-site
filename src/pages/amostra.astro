---
// Página interna de aprovação do design system (etapa 2). Sai do ar antes do lançamento.
import Base from "../layouts/Base.astro";
import Botao from "../components/ui/Botao.astro";
import Selo from "../components/ui/Selo.astro";
import Rotulo from "../components/ui/Rotulo.astro";
import Secao from "../components/ui/Secao.astro";
import Cartao from "../components/ui/Cartao.astro";
import Campo from "../components/ui/Campo.astro";
import logo from "../assets/logo/logo-horizontal-escuro.svg?raw";
import { montarLinkWhatsapp } from "../lib/whatsapp";

const cores = [
  { nome: "Preto profundo", hex: "#0B0F14", uso: "Fundo principal" },
  { nome: "Grafite", hex: "#202833", uso: "Superfícies e cartões" },
  { nome: "Ciano elétrico", hex: "#35D5E8", uso: "O único destaque, no escuro" },
  { nome: "Ciano profundo", hex: "#0B7C8C", uso: "Destaque em fundo claro" },
  { nome: "Prata fria", hex: "#D6DDE6", uso: "Texto principal" },
  { nome: "Linha", hex: "#2E3946", uso: "Divisórias e bordas" },
];

const tipos = [
  { token: "Display", spec: "Space Grotesk 600 · 56/60", classe: "t-display", texto: "Seu cliente chega no WhatsApp pronto para fechar." },
  { token: "H1", spec: "Space Grotesk 600 · 40/46", classe: "t-h1", texto: "Escolha o seu plano" },
  { token: "H2", spec: "Space Grotesk 500 · 28/34", classe: "t-h2", texto: "Do briefing ao site no ar" },
  { token: "Texto grande", spec: "Inter 400 · 18/28", classe: "t-body-lg", texto: "Landing pages e sites personalizados, com copy de conversão inclusa, para negócios que vendem serviços de alto valor e fecham pelo WhatsApp." },
  { token: "Texto", spec: "Inter 400 · 16/26", classe: "t-body", texto: "Você para de explicar a mesma coisa vinte vezes por dia e passa a falar só com quem está pronto para contratar." },
  { token: "Pequeno", spec: "Inter 400 · 14/20", classe: "t-small", texto: "Resposta em até 1 dia útil · Preços abertos na página" },
];

const opcoesProjeto = ["Landing page", "Site completo", "Ainda não sei"];
const opcoesInvestimento = ["Até R$ 1.000", "De R$ 1.000 a R$ 2.000", "Acima de R$ 2.000", "Prefiro conversar antes"];
---
<Base titulo="Amostra do design system | BRAGA SYSTEMS" semIndexar moldura={false}>
  <header class="topo-amostra">
    <div class="topo-amostra__conteudo">
      <div class="topo-amostra__logo" set:html={logo} />
      <p class="topo-amostra__nota">Página interna de aprovação · sai do ar antes do lançamento</p>
    </div>
  </header>

  <main>
    <Secao>
      <div class="abertura">
        <h1 class="abertura__titulo">As peças do site, antes de virarem página.</h1>
        <p class="abertura__texto">Cores, letras, botões, selos, cartões e campos da BRAGA SYSTEMS. Abra no celular, toque em tudo e veja se tem a cara da marca. Passe o mouse ou use a tecla Tab para ver os estados.</p>
      </div>
    </Secao>

    <Secao id="cores">
      <div class="bloco">
        <div class="bloco__cabeca"><Rotulo>Cores</Rotulo><p class="bloco__nota">O preto domina. O ciano aparece uma vez por bloco.</p></div>
        <ul class="cores">
          {cores.map((c) => (
            <li class="cor">
              <span class="cor__amostra chanfrado" style={`--cor-fundo:${c.hex};--cor-borda:${c.hex === "#0B0F14" ? "#2E3946" : c.hex}`}></span>
              <span class="cor__nome">{c.nome}</span>
              <span class="cor__hex num">{c.hex}</span>
              <span class="cor__uso">{c.uso}</span>
            </li>
          ))}
        </ul>
      </div>
    </Secao>

    <Secao id="tipografia">
      <div class="bloco">
        <div class="bloco__cabeca"><Rotulo>Tipografia</Rotulo><p class="bloco__nota">Space Grotesk nos títulos, Inter no texto, JetBrains Mono nos rótulos.</p></div>
        <dl class="tipos">
          {tipos.map((t) => (
            <div class="tipo">
              <dt class="tipo__spec"><span class="tipo__token">{t.token}</span><span class="num">{t.spec}</span></dt>
              <dd class:list={["tipo__exemplo", t.classe]}>{t.texto}</dd>
            </div>
          ))}
          <div class="tipo">
            <dt class="tipo__spec"><span class="tipo__token">Rótulo</span><span class="num">JetBrains Mono 500 · 12/16</span></dt>
            <dd class="tipo__exemplo"><Rotulo destaque>Planos</Rotulo></dd>
          </div>
        </dl>
      </div>
    </Secao>

    <Secao id="botoes">
      <div class="bloco">
        <div class="bloco__cabeca"><Rotulo>Botões</Rotulo><p class="bloco__nota">Um só botão preenchido por bloco. Os outros são vazados.</p></div>
        <div class="vitrine">
          <div class="linha-botoes">
            <Botao href={montarLinkWhatsapp("hero")} icone="whatsapp" origem="hero">Quero meu site</Botao>
            <Botao variante="secundario" href="#cartoes" icone="seta">Ver projetos</Botao>
          </div>
          <dl class="estados">
            <div class="estado"><dt>Carregando</dt><dd><Botao carregando>Gerar minha headline</Botao></dd></div>
            <div class="estado"><dt>Desativado</dt><dd><Botao desativado icone="whatsapp">Receber no WhatsApp</Botao></dd></div>
            <div class="estado"><dt>Largura total, no celular</dt><dd class="estado__cheio"><Botao larguraTotal tipo="submit" icone="seta">Quero meu site</Botao></dd></div>
          </dl>
        </div>
      </div>
    </Secao>

    <Secao id="selos">
      <div class="bloco">
        <div class="bloco__cabeca"><Rotulo>Selos</Rotulo><p class="bloco__nota">O selo de vagas muda sozinho conforme o contador do Supabase.</p></div>
        <dl class="estados">
          <div class="estado"><dt>Com vagas</dt><dd><Selo estado="com-vagas" vagas={5} /></dd></div>
          <div class="estado"><dt>Esgotado</dt><dd><Selo estado="esgotado" /></dd></div>
          <div class="estado"><dt>Falha ao carregar</dt><dd><Selo estado="falha" /></dd></div>
          <div class="estado"><dt>Plano recomendado</dt><dd><Selo tipo="recomendado" /></dd></div>
        </dl>
      </div>
    </Secao>

    <Secao id="cartoes">
      <div class="bloco">
        <div class="bloco__cabeca"><Rotulo>Cartões</Rotulo><p class="bloco__nota">Padrão e destaque. O brilho ciano é só do plano Performance.</p></div>
        <div class="cartoes">
          <Cartao as="article">
            <h3 class="plano__nome">Plano Essencial</h3>
            <p class="plano__preco"><s class="num">R$ 932</s> <strong class="num">R$ 699</strong> <span>preço de fundador</span></p>
            <p class="plano__para">Para quem precisa de uma página bem feita, rápido.</p>
            <Botao variante="secundario" href={montarLinkWhatsapp("essencial")} origem="essencial" larguraTotal>Quero o Essencial</Botao>
          </Cartao>
          <Cartao as="article" variante="destaque">
            <Selo tipo="recomendado" class="plano__selo" />
            <h3 class="plano__nome">Plano Performance</h3>
            <p class="plano__preco"><s class="num">R$ 1.596</s> <strong class="num">R$ 1.197</strong> <span>preço de fundador</span></p>
            <p class="plano__para">Para quem vai anunciar e quer cada clique valendo.</p>
            <Botao href={montarLinkWhatsapp("performance")} origem="performance" larguraTotal icone="whatsapp">Quero o Performance</Botao>
          </Cartao>
        </div>
      </div>
    </Secao>

    <Secao id="campos">
      <div class="bloco">
        <div class="bloco__cabeca"><Rotulo>Campos</Rotulo><p class="bloco__nota">O formulário curto da seção 16, com um erro de exemplo no WhatsApp.</p></div>
        <form class="formulario" novalidate onsubmit="return false">
          <Campo id="a-nome" nome="nome" rotulo="Seu nome" autocomplete="name" maxlength={80} />
          <Campo id="a-whatsapp" nome="whatsapp" tipo="telefone" rotulo="Seu WhatsApp" placeholder="(61) 99999-9999" valor="61 9999" erro="Confira o número com DDD." />
          <Campo id="a-projeto" nome="tipo_projeto" tipo="selecao" rotulo="O que você precisa?" opcoes={opcoesProjeto} />
          <Campo id="a-investimento" nome="investimento" tipo="selecao" rotulo="Quanto pretende investir?" opcoes={opcoesInvestimento} />
          <Campo id="a-consentimento" nome="consentimento" tipo="consentimento">
            Autorizo o contato pelo WhatsApp e o uso dos meus dados conforme a <a href="/privacidade">Política de Privacidade</a>.
          </Campo>
          <div class="formulario__envio">
            <Botao tipo="submit" larguraTotal icone="seta">Quero meu site</Botao>
            <p class="formulario__micro">Resposta em até 1 dia útil · Preço de fundador enquanto houver vagas</p>
          </div>
        </form>
      </div>
    </Secao>

    <Secao id="claro" tema="claro">
      <div class="bloco">
        <div class="bloco__cabeca"><Rotulo>Seção clara</Rotulo><p class="bloco__nota">Para dar ritmo à página. Aqui o ciano vira ciano profundo.</p></div>
        <div class="claro">
          <h2 class="t-h1">Não gostou do primeiro layout? Eu refaço do zero, sem custo.</h2>
          <p class="t-body-lg claro__texto">Você só segue para o desenvolvimento quando aprovar o visual.</p>
          <div class="linha-botoes">
            <Botao href={montarLinkWhatsapp("hero")} icone="whatsapp" origem="hero">Quero meu site</Botao>
            <Botao variante="secundario" href="#cores" icone="seta">Ver projetos</Botao>
          </div>
          <div class="claro__campo">
            <Campo id="c-nome" nome="nome-claro" rotulo="Seu nome" />
            <Campo id="c-consentimento" nome="consentimento-claro" tipo="consentimento">
              Autorizo o contato pelo WhatsApp e o uso dos meus dados conforme a <a href="/privacidade">Política de Privacidade</a>.
            </Campo>
          </div>
        </div>
      </div>
    </Secao>
  </main>
</Base>

<style>
  .topo-amostra {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .topo-amostra__conteudo {
    width: min(100% - 2 * var(--gutter), var(--largura-max));
    margin-inline: auto;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .topo-amostra__logo :global(svg) { width: 148px; height: auto; }
  .topo-amostra__nota { display: none; font: 500 var(--t-label)/1.3 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
  @media (min-width: 720px) { .topo-amostra__nota { display: block; } }

  .abertura { display: grid; gap: var(--s-5); max-width: 44rem; }
  .abertura__titulo { font-size: var(--t-display); line-height: 1.05; letter-spacing: -0.03em; }
  .abertura__texto { font-size: var(--t-body-lg); line-height: 1.6; color: var(--ink-muted); max-width: var(--largura-texto); }

  .bloco { display: grid; gap: var(--s-6); }
  .bloco__cabeca { display: grid; gap: var(--s-3); align-content: start; }
  .bloco__nota { color: var(--ink-muted); font-size: var(--t-small); max-width: 32ch; }
  @media (min-width: 960px) {
    .bloco { grid-template-columns: 240px minmax(0, 1fr); gap: var(--s-8); }
  }

  .cores { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--s-4); }
  @media (min-width: 720px) { .cores { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cor { display: grid; gap: 2px; }
  .cor__amostra { --c: 14px; display: block; aspect-ratio: 16 / 10; margin-bottom: var(--s-3); }
  .cor__nome { font: 500 var(--t-small)/1.3 var(--font-sans); color: var(--ink-strong); }
  .cor__hex { font: 400 var(--t-label)/1.4 var(--font-mono); letter-spacing: 0.06em; color: var(--ink); }
  .cor__uso { font-size: var(--t-small); line-height: 1.4; color: var(--ink-muted); }

  .tipos { margin: 0; display: grid; }
  .tipo { display: grid; gap: var(--s-2); padding-block: var(--s-5); border-top: 1px solid var(--line); }
  .tipo:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 720px) { .tipo { grid-template-columns: 180px minmax(0, 1fr); gap: var(--s-5); align-items: baseline; } }
  .tipo__spec { display: grid; gap: 2px; font: 400 var(--t-label)/1.5 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-muted); }
  .tipo__token { color: var(--ink); }
  .tipo__exemplo { margin: 0; min-width: 0; }
  .t-display { font: 600 var(--t-display)/1.07 var(--font-display); letter-spacing: -0.03em; color: var(--ink-strong); text-wrap: balance; }
  .t-h1 { font: 600 var(--t-h1)/1.15 var(--font-display); letter-spacing: -0.02em; color: var(--ink-strong); text-wrap: balance; }
  .t-h2 { font: 500 var(--t-h2)/1.2 var(--font-display); letter-spacing: -0.02em; color: var(--ink-strong); }
  .t-body-lg { font-size: var(--t-body-lg); line-height: 1.55; max-width: var(--largura-texto); }
  .t-body { font-size: var(--t-body); max-width: var(--largura-texto); }
  .t-small { font-size: var(--t-small); line-height: 1.45; color: var(--ink-muted); }

  .vitrine { display: grid; gap: var(--s-7); }
  .linha-botoes { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .estados { margin: 0; display: grid; gap: var(--s-5); }
  @media (min-width: 720px) { .estados { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .estado { display: grid; gap: var(--s-3); align-content: start; }
  .estado dt { font: 500 var(--t-label)/1.3 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
  .estado dd { margin: 0; }
  .estado__cheio { max-width: 360px; }

  .cartoes { display: grid; gap: var(--s-5); }
  @media (min-width: 720px) { .cartoes { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; } }
  .plano__nome { font: 500 var(--t-label)/1.3 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); }
  .cartao--destaque .plano__nome { color: var(--ink); }
  :global(.plano__selo) { align-self: flex-start; }
  .plano__preco { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; }
  .plano__preco s { color: var(--ink-muted); font-size: var(--t-small); }
  .plano__preco strong { font: 600 clamp(2rem, 1.7rem + 1.2vw, 2.5rem)/1 var(--font-display); letter-spacing: -0.03em; color: var(--ink-strong); }
  .plano__preco span { font-size: var(--t-small); color: var(--ink-muted); }
  .plano__para { color: var(--ink); margin-bottom: var(--s-2); }

  .formulario { display: grid; gap: var(--s-5); max-width: 520px; }
  .formulario__envio { display: grid; gap: var(--s-3); margin-top: var(--s-2); }
  .formulario__micro { font-size: var(--t-small); color: var(--ink-muted); text-align: center; }

  .claro { display: grid; gap: var(--s-5); }
  .claro__texto { color: var(--ink-muted); }
  .claro__campo { display: grid; gap: var(--s-5); max-width: 520px; margin-top: var(--s-4); }
</style>
