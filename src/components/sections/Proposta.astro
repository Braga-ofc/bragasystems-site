---
/*
  Proposta + Benefícios (copy 2.11, uma seção só desde 20/10/2026). Animação "A venda andando",
  escolhida pelo Gustavo, toda presa à rolagem (subindo, desfaz):
  - Título: a primeira frase sai do desfoque; "vender" ganha o marca-texto do site.
  - Virada: o trilho se desenha até o nó, o nó acende com uma onda (como o fio entre as seções)
    e a frase entra em foco logo abaixo.
  - Placa de benefícios: cada linha acende quando passa pelo meio da tela, uma por vez, na ordem;
    com mouse, um brilho neutro segue o cursor na linha (Magic Card do Magic UI, MIT).
  Elementos gráficos (pedido do Gustavo, 20/10/2026): no trilho, antes do nó, três estações com as
  formas do núcleo do B (página, dúvida respondida, preço) acendem uma a uma: é a metade da venda
  que a página faz antes de o cliente chamar. Cada benefício tem o seu ícone nas mesmas formas.
  No fundo, linhas finas em 0°/45° com uma luz que circula por elas, bem apagadas, só com a seção
  à vista. O único ciano forte do bloco é o nó (o marca-texto é a assinatura das frases-chave).
  Sem suporte ou com movimento reduzido: tudo aceso e parado.
*/
import Secao from "../ui/Secao.astro";
import { proposta } from "../../content/home";
import { aspas } from "../../lib/texto";

// Formas do núcleo do B (as mesmas de ui/CamadaViva), em viewBox 48
const formas = {
  quadro: "M10 4 L44 4 L44 34 L34 44 L4 44 L4 10 Z M12 12 L36 12 L36 31 L31 36 L12 36 Z",
  check: "M6 26 L14 18 L20 24 L34 10 L42 18 L20 40 Z",
  preco: "M8 8 L28 8 L42 22 L42 26 L26 42 L8 24 Z M18 15 L22 15 L22 19 L18 19 Z",
  balao: "M8 6 L42 6 L42 30 L36 36 L20 36 L10 44 L10 36 L6 36 L6 8 Z",
  seta: "M8 8 L18 8 L24 14 L30 8 L40 8 L24 24 Z M8 22 L18 22 L24 28 L30 22 L40 22 L24 38 Z",
};
// Antes do nó: a página apresenta, responde as dúvidas e mostra o valor
const estacoes = [formas.quadro, formas.check, formas.preco];
// Um ícone por benefício, na ordem da copy
const icones = [formas.balao, formas.preco, formas.quadro, formas.seta];

// Linhas do fundo: só 0°, 45° e 90°, como o símbolo (viewBox 1440 × 1000)
const linhas = [
  "M-40 180 H320 L520 380 H900 L1100 180 H1480",
  "M-40 620 H180 L380 820 H760 L960 620 H1480",
  "M260 -40 V140 L460 340 V1040",
  "M1180 -40 V420 L980 620 V1040",
];

// "Um site bonito não basta." | "Ele precisa vender." — a segunda frase leva o marca-texto em "vender"
const [afirmacao, ...resto] = proposta.titulo.split(/(?<=\.)\s+/);
const virada = resto.join(" ").replace("vender", '<mark data-marca="pronta">vender</mark>');
---
<Secao class="proposta">
  <svg class="proposta__fundo" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-proposta-fundo>
    {linhas.map((d, i) => (
      <>
        <path class="proposta__fio" d={d} />
        <path class="proposta__luz" d={d} pathLength="1000" style={`--i:${i}`} />
      </>
    ))}
  </svg>
  <div class="proposta__grade">
    <h2 class="proposta__titulo">
      <span class="proposta__afirmacao foco-rolagem">{afirmacao}</span>
      {virada && <> <span class="proposta__vira" set:html={virada} /></>}
    </h2>

    <div class="proposta__virada">
      <span class="proposta__trilho" aria-hidden="true"></span>
      <span class="proposta__estacoes" aria-hidden="true">
        {estacoes.map((d, i) => (
          <svg class="proposta__estacao" viewBox="0 0 48 48" style={`--i:${i}`}><path d={d} fill-rule="evenodd" /></svg>
        ))}
      </span>
      <span class="proposta__no" aria-hidden="true"><span class="proposta__onda"></span></span>
      <p class="proposta__frase sobe-rolagem">{proposta.frase}</p>
    </div>

    <h3 class="proposta__subtitulo foco-rolagem">{proposta.beneficiosTitulo}</h3>
    <div class="proposta__placa chanfrado">
      <ul class="proposta__lista" role="list" data-proposta-luz>
        {proposta.beneficios.map((item, i) => (
          <li class="proposta__item">
            <p class="proposta__destaque">
              <svg class="proposta__icone" viewBox="0 0 48 48" aria-hidden="true"><path d={icones[i]} fill-rule="evenodd" /></svg>
              {item.destaque}
            </p>
            <p class="proposta__texto">{aspas(item.texto)}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* O script fica dentro da Secao: fora dela, quebraria a linha divisória entre seções */}
  <script>
    // As linhas do fundo só correm com a seção à vista
    const fundo = document.querySelector<SVGElement>("[data-proposta-fundo]");
    if (fundo && "IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => fundo.classList.toggle("is-na-tela", e.isIntersecting)).observe(fundo);
    }

    // Brilho que segue o cursor na linha sob ele. Só com mouse; no toque e com movimento reduzido, nada.
    const lista = document.querySelector<HTMLElement>("[data-proposta-luz]");
    if (lista && matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let quadro = 0, x = 0, y = 0;
      let alvo: HTMLElement | null = null;
      lista.addEventListener("pointermove", (e) => {
        alvo = (e.target as Element).closest<HTMLElement>(".proposta__item");
        x = e.clientX;
        y = e.clientY;
        if (quadro || !alvo) return;
        quadro = requestAnimationFrame(() => {
          quadro = 0;
          if (!alvo) return;
          const caixa = alvo.getBoundingClientRect();
          alvo.style.setProperty("--luz-x", `${Math.round(x - caixa.left)}px`);
          alvo.style.setProperty("--luz-y", `${Math.round(y - caixa.top)}px`);
        });
      }, { passive: true });
    }
  </script>
</Secao>

<style>
  .proposta__grade { position: relative; display: grid; min-width: 0; }

  /* ---------- Fundo: linhas apagadas com uma luz que circula ---------- */
  .proposta { overflow: clip; }
  .proposta__fundo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(transparent, #000 15%, #000 85%, transparent);
  }
  .proposta__fio { fill: none; stroke: var(--line); stroke-width: 1; opacity: 0.45; vector-effect: non-scaling-stroke; }
  .proposta__luz {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-dasharray: 70 930;
    stroke-dashoffset: 1000;
    opacity: 0.28;
    vector-effect: non-scaling-stroke;
  }
  @media (prefers-reduced-motion: no-preference) {
    .proposta__luz { animation: proposta-circula calc(11s + var(--i) * 2.5s) linear calc(var(--i) * -3s) infinite paused; }
    .proposta__fundo:global(.is-na-tela) .proposta__luz { animation-play-state: running; }
  }
  @keyframes proposta-circula { to { stroke-dashoffset: 0; } }
  @media (forced-colors: active) { .proposta__fundo { display: none; } }

  /* ---------- Estações no trilho e ícones dos benefícios ---------- */
  .proposta__estacoes { display: none; }
  .proposta__estacao, .proposta__icone { fill: currentColor; }
  .proposta__icone {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    margin-right: 0.55em;
    vertical-align: -0.1em;
    color: var(--ink-muted);
  }

  .proposta__titulo {
    max-width: 18ch;
    font-size: var(--t-h1);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
    text-wrap: balance;
  }
  .proposta__afirmacao { display: inline-block; color: var(--ink-muted); }

  /* A virada: trilho fino com o nó em losango, e a frase logo abaixo */
  .proposta__virada {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: var(--s-8);
    view-timeline: --proposta-virada block;
  }
  .proposta__trilho,
  .proposta__no { grid-row: 1; grid-column: 1 / -1; }
  .proposta__trilho {
    align-self: center;
    height: 1px;
    background: var(--line-forte);
    transform-origin: left;
  }
  .proposta__no {
    position: relative;
    align-self: center;
    justify-self: start;
    width: 14px;
    height: 14px;
  }
  .proposta__no::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    filter: drop-shadow(0 0 6px var(--brilho));
  }
  .proposta__onda {
    position: absolute;
    inset: -9px;
    border: 1px solid var(--accent);
    rotate: 45deg;
    opacity: 0;
  }
  .proposta__frase {
    max-width: 24ch;
    margin-top: var(--s-5);
    font: 500 var(--t-h2)/1.25 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink-strong);
    text-wrap: balance;
  }

  /* ---------- Placa de benefícios ---------- */
  .proposta__subtitulo {
    margin-top: var(--s-9);
    font: 500 var(--t-h3)/1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink-muted);
  }
  .proposta__placa {
    --c: var(--chanfro-lg);
    --cor-borda: var(--line);
    --cor-fundo: var(--surface);
    min-width: 0;
    margin-top: var(--s-5);
  }
  /* A lista acompanha o recorte da placa, para o brilho não vazar pelos cantos */
  .proposta__lista {
    --recorte: calc(var(--c) - 1px);
    margin: 1px;
    padding: 0;
    list-style: none;
    clip-path: polygon(var(--recorte) 0, 100% 0, 100% calc(100% - var(--recorte)), calc(100% - var(--recorte)) 100%, 0 100%, 0 var(--recorte));
  }
  .proposta__item {
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
  }
  .proposta__item + .proposta__item { border-top: 1px solid var(--line); }
  .proposta__destaque {
    position: relative;
    font: 500 var(--t-h3)/1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    text-wrap: balance;
  }
  .proposta__texto {
    position: relative;
    max-width: 52ch;
    line-height: 1.6;
    color: var(--ink-muted);
  }
  /* Brilho neutro sob o cursor */
  .proposta__item::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(280px circle at var(--luz-x, 50%) var(--luz-y, 50%), color-mix(in srgb, var(--ink-strong) 7%, transparent), transparent 70%);
    transition: opacity var(--dur) var(--ease-saida);
  }
  @media (hover: hover) and (pointer: fine) {
    .proposta__item:hover::before { opacity: 1; }
  }

  /* ---------- Movimento preso à rolagem ---------- */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .proposta__trilho { animation: proposta-trilho linear both; animation-timeline: --proposta-virada; animation-range: entry 20% cover 45%; }
      .proposta__no::before { animation: proposta-no linear both; animation-timeline: --proposta-virada; animation-range: cover 40% cover 50%; }
      .proposta__onda { animation: proposta-onda linear both; animation-timeline: --proposta-virada; animation-range: cover 44% cover 62%; }
      .proposta__estacao { animation: proposta-estacao linear both; animation-timeline: --proposta-virada; animation-range: cover calc(28% + var(--i) * 4%) cover calc(33% + var(--i) * 4%); }
      /* Cada linha acende quando passa pelo meio da tela e fica acesa em tom normal depois */
      .proposta__destaque, .proposta__texto { animation: proposta-linha linear both; animation-timeline: view(); animation-range: cover 0% cover 100%; }
    }
  }
  @keyframes proposta-trilho { from { transform: scaleX(0); } }
  @keyframes proposta-estacao { from { opacity: 0; scale: 0.4; } to { opacity: 1; scale: 1; } }
  @keyframes proposta-no { from { opacity: 0.15; scale: 0.3; rotate: -90deg; } }
  @keyframes proposta-onda {
    0% { opacity: 0.9; scale: 0.5; }
    100% { opacity: 0; scale: 1.8; }
  }
  @keyframes proposta-linha {
    0%, 30% { opacity: 0.35; }
    45%, 58% { opacity: 1; }
    75%, 100% { opacity: 0.75; }
  }

  @media (min-width: 960px) {
    .proposta__grade,
    .proposta__virada {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--s-5);
    }
    /* A afirmação da página: o título no tamanho de exibição */
    .proposta__titulo {
      grid-column: 1 / span 10;
      max-width: 22ch;
      font-size: var(--t-display);
      line-height: 1.06;
      letter-spacing: -0.03em;
    }
    .proposta__virada { grid-column: 1 / -1; margin-top: var(--s-9); }
    .proposta__trilho { grid-column: 1 / -1; }
    /* O nó cai no meio do trilho, no início da coluna 7, onde a frase começa */
    .proposta__no { grid-column: 7 / -1; translate: -7px 0; }
    .proposta__frase { grid-column: 7 / -1; margin-top: var(--s-6); }
    /* As três estações dividem a metade de antes do nó; o fundo delas recorta o trilho */
    .proposta__estacoes {
      grid-row: 1;
      grid-column: 1 / 7;
      display: flex;
      align-items: center;
      justify-content: space-around;
      padding-right: var(--s-5);
    }
    .proposta__estacao {
      width: 30px;
      height: 30px;
      padding: 6px;
      box-sizing: content-box;
      color: var(--ink-muted);
      background: var(--surface);
    }
    .proposta__subtitulo { grid-column: 1 / -1; }
    .proposta__placa { grid-column: 1 / -1; }
    /* Tabela: o que muda (5/12) | como (7/12), com a régua vertical na divisa */
    .proposta__item {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
      gap: 0;
      padding: var(--s-5) var(--s-6);
    }
    .proposta__item::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--s-6) + (100% - 2 * var(--s-6)) * 5 / 12);
      width: 1px;
      background: var(--line);
    }
    .proposta__destaque { padding-right: var(--s-6); }
    .proposta__texto { padding-left: var(--s-6); }
  }
</style>
