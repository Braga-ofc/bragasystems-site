---
/*
  Topo fixo (copy §1): logo, links da home e o WhatsApp sempre a um toque.
  Computador (≥ 960 px): links em linha. Celular: os links vão para um menu (scripts/menu.ts)
  e o botão de WhatsApp continua visível; abaixo de 380 px ele fica só com o ícone.
  Sem JavaScript, o botão do menu some e os links aparecem numa linha abaixo da barra.
*/
import Botao from "../ui/Botao.astro";
import Icone from "../ui/Icone.astro";
import logo from "../../assets/logo/logo-horizontal-escuro.svg?raw";
import { topo } from "../../content/home";
import { site } from "../../config/site";
import { montarLinkWhatsapp } from "../../lib/whatsapp";

// Na home, as âncoras só rolam (#metodo): sem recarregar a página nem perder os ?utm_ do endereço.
// Nas outras páginas, levam de volta à home (/#metodo). "Quem sou" é página.
const caminho = Astro.url.pathname.replace(/\/$/, "") || "/";
const naHome = caminho === "/";
const links = topo.links.map((l) => ({
  texto: l.texto,
  href: "href" in l ? l.href : naHome ? `#${l.ancora}` : `/#${l.ancora}`,
}));
const atual = (href: string) => (href === caminho ? "page" : undefined);
---
<header class="topo">
  <div class="topo__barra">
    <a class="topo__logo" href="/" aria-label={site.nome} set:html={logo} />

    <nav class="topo__nav">
      <ul class="topo__links" role="list">
        {links.map((l) => (
          <li><a class="topo__link" href={l.href} aria-current={atual(l.href)}>{l.texto}</a></li>
        ))}
      </ul>
    </nav>

    <div class="topo__acoes">
      <Botao variante="secundario" sempre icone="whatsapp" origem="topo" href={montarLinkWhatsapp("topo")}>{topo.botao}</Botao>
      <button class="topo__menu chanfrado" type="button" aria-expanded="false" aria-controls="topo-menu" aria-label="Menu" data-menu-botao>
        <span class="topo__menu-linhas" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="topo__painel" id="topo-menu" hidden data-menu-painel>
    <nav>
      <ul class="topo__painel-links" role="list">
        {links.map((l) => (
          <li>
            <a class="topo__painel-link" href={l.href} aria-current={atual(l.href)}>
              <span>{l.texto}</span>
              <Icone nome="seta" class="topo__painel-seta" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  {/* Véu sobre a página enquanto o menu está aberto: tocar nele fecha (scripts/menu.ts) */}
  <div class="topo__veu" aria-hidden="true" data-menu-veu></div>

  {/* Sem JavaScript o menu não abre: o botão some e os links ficam numa linha logo abaixo da barra */}
  <noscript>
    <style is:inline>
      header.topo .topo__menu { display: none; }
      @media (max-width: 959.98px) {
        html { scroll-padding-top: 124px; }
        header.topo .topo__barra { flex-wrap: wrap; row-gap: 0; padding-top: var(--s-2); }
        header.topo .topo__nav { display: block; order: 3; flex: 1 0 100%; }
        header.topo .topo__links { flex-wrap: wrap; justify-content: space-between; gap: 0 var(--s-2); }
        header.topo .topo__link { font-size: 0.875rem; }
      }
      @media (min-width: 600px) and (max-width: 959.98px) {
        header.topo .topo__links { justify-content: flex-start; gap: 0 var(--s-5); }
      }
    </style>
  </noscript>
</header>

<script>
  import "../../scripts/menu";
</script>

<style>
  /*
    Linha neon do cabeçalho (pedido do Gustavo, 19/10/2026): um traço curto de luz que corre a borda
    de baixo da direita para a esquerda. Só transform, no compositor; para com movimento reduzido.
  */
  .topo::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 22%;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--ciano-eletrico-forte) 60%, transparent);
    box-shadow: 0 0 6px 0 rgb(53 213 232 / 0.5);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .topo::after { opacity: 0.8; animation: topo-neon 7s linear infinite; will-change: transform; }
  }
  @keyframes topo-neon {
    from { transform: translateX(100vw); }
    to { transform: translateX(-100%); }
  }
  @media (forced-colors: active) { .topo::after { display: none; } }

  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Sem backdrop-filter: com o fundo vivo sempre em movimento, o desfoque era refeito a cada quadro e travava o computador */
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .topo__barra {
    width: min(100% - 2 * var(--gutter), var(--largura-max));
    min-height: 63px; /* + 1 px da linha inferior = 64 px */
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* Logo: só tamanho, nunca efeito */
  .topo__logo {
    display: flex;
    align-items: center;
    flex: none;
    width: 128px;
    min-height: 44px;
    margin-right: auto;
  }
  .topo__logo :global(svg) { width: 100%; height: auto; }

  /* Links do computador */
  .topo__nav { display: none; }
  .topo__links {
    display: flex;
    align-items: center;
    gap: var(--s-1) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topo__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 500 0.9375rem/1 var(--font-sans);
    letter-spacing: -0.005em;
    color: var(--ink);
    text-decoration: none;
    /* Sublinhado ciano de 1 px que corre da esquerda ao passar o mouse */
    background: linear-gradient(var(--accent), var(--accent)) left calc(50% + 0.75em) / 0 1px no-repeat;
    transition: color var(--dur) var(--ease-saida), background-size var(--dur) var(--ease-saida);
  }
  .topo__link:hover { color: var(--ink-strong); background-size: 100% 1px; }
  .topo__link:active { color: var(--ink); }
  .topo__link[aria-current="page"] { color: var(--ink-strong); background-size: 100% 1px; }

  /* Ações: WhatsApp compacto e o botão do menu */
  .topo__acoes {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: none;
  }
  .topo__acoes :global(.botao) {
    min-height: 44px;
    padding: 0 10px;
    gap: 8px;
    font-size: 0.875rem;
  }
  .topo__acoes :global(.botao__icone) { display: none; width: 18px; height: 18px; }

  /* Abaixo de 380 px: só o ícone; o texto continua para leitores de tela */
  @media (max-width: 379.98px) {
    .topo__acoes :global(.botao) { width: 44px; padding: 0; }
    .topo__acoes :global(.botao__icone) { display: block; }
    .topo__acoes :global(.botao__texto) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (min-width: 520px) {
    .topo__acoes :global(.botao) { padding: 0 14px 0 16px; }
    .topo__acoes :global(.botao__icone) { display: block; }
  }

  .topo__menu {
    --c: var(--chanfro-sm);
    --cor-borda: var(--line-forte);
    --cor-fundo: var(--surface);
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-strong);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: --cor-borda var(--dur) var(--ease-saida), --cor-fundo var(--dur) var(--ease-saida), translate var(--dur-rapida) var(--ease-saida);
  }
  .topo__menu:hover { --cor-borda: var(--ink-muted); }
  .topo__menu:active { translate: 0 1px; }
  .topo__menu:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .topo__menu[aria-expanded="true"] { --cor-fundo: var(--surface-sunken); }

  /*
    Três linhas que viram um X em dois tempos: primeiro se encontram no meio, depois giram
    (45° e 135°, os ângulos da marca). Ao fechar, a ordem se inverte. Ao passar o mouse, a linha
    do meio recua. Variação do botão de menu de ArturCodeCraft (Uiverse, MIT), recriada em CSS.
  */
  .topo__menu-linhas {
    --tempo: 170ms;
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }
  .topo__menu-linhas > span {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% - 0.875px);
    height: 1.75px;
    background: currentColor;
    transform-origin: center;
    transition:
      translate var(--tempo) var(--ease-saida) var(--tempo),
      rotate var(--tempo) var(--ease-saida),
      scale var(--dur-rapida) var(--ease-saida),
      background-color var(--dur) var(--ease-saida);
  }
  .topo__menu-linhas > span:nth-child(1) { translate: 0 -6px; }
  .topo__menu-linhas > span:nth-child(3) { translate: 0 6px; }
  .topo__menu-linhas > span:nth-child(2) { transform-origin: right center; }
  .topo__menu:hover .topo__menu-linhas > span:nth-child(2) { scale: 0.55 1; }

  .topo__menu[aria-expanded="true"] .topo__menu-linhas > span {
    background-color: var(--accent);
    transition:
      translate var(--tempo) var(--ease-saida),
      rotate var(--tempo) var(--ease-saida) var(--tempo),
      scale var(--dur-rapida) var(--ease-saida),
      background-color var(--dur) var(--ease-saida);
  }
  .topo__menu[aria-expanded="true"] .topo__menu-linhas > span:nth-child(1) { translate: 0 0; rotate: 45deg; }
  .topo__menu[aria-expanded="true"] .topo__menu-linhas > span:nth-child(2) { scale: 0 1; }
  .topo__menu[aria-expanded="true"] .topo__menu-linhas > span:nth-child(3) { translate: 0 0; rotate: 135deg; }

  @media (prefers-reduced-motion: reduce) {
    .topo__menu-linhas > span,
    .topo__menu[aria-expanded="true"] .topo__menu-linhas > span {
      transition: background-color var(--dur-rapida) var(--ease-saida);
    }
  }
  @media (forced-colors: active) {
    .topo__menu-linhas > span,
    .topo__menu[aria-expanded="true"] .topo__menu-linhas > span { background-color: ButtonText; }
  }

  /*
    Painel do menu no celular: uma camada acima da página, logo abaixo do topo. A sombra e o véu
    separam o painel do conteúdo; a rolagem continua livre e fecha o menu (scripts/menu.ts).
  */
  .topo__painel {
    position: absolute;
    z-index: 1; /* acima do véu */
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface-sunken);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.6);
  }
  .topo__painel[hidden] { display: none; }

  /* Véu: escurece a página abaixo do painel, do topo até o fim da tela */
  .topo__veu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: calc(100dvh - 100%);
    background: color-mix(in srgb, var(--surface-sunken) 60%, transparent);
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 959.98px) {
    .topo__painel:not([hidden]) + .topo__veu { display: block; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .topo__painel:not([hidden]) { animation: topo-painel-abre var(--dur) var(--ease-saida); }
    .topo__painel:not([hidden]) + .topo__veu { animation: topo-veu-entra var(--dur) var(--ease-saida); }
  }
  @keyframes topo-painel-abre {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes topo-veu-entra {
    from { opacity: 0; }
  }

  .topo__painel-links {
    width: min(100% - 2 * var(--gutter), var(--largura-max));
    margin: 0 auto;
    padding: var(--s-2) 0 var(--s-6);
    list-style: none;
  }
  .topo__painel-links li + li { border-top: 1px solid var(--line); }
  .topo__painel-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 56px;
    font: 500 1.375rem/1.2 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-rapida) var(--ease-saida);
  }
  .topo__painel-link :global(.topo__painel-seta) {
    color: var(--ink-muted);
    transition: translate var(--dur) var(--ease-saida), color var(--dur) var(--ease-saida);
  }
  .topo__painel-link:hover :global(.topo__painel-seta),
  .topo__painel-link:focus-visible :global(.topo__painel-seta) { translate: 4px 0; color: var(--accent); }
  .topo__painel-link:active { color: var(--ink); }
  .topo__painel-link:focus-visible { outline-offset: -2px; }
  .topo__painel-link[aria-current="page"] :global(.topo__painel-seta) { color: var(--accent); }

  @media (min-width: 960px) {
    .topo__barra { min-height: 71px; gap: 0; }
    .topo__logo { width: 148px; }
    .topo__nav { display: block; }
    .topo__menu, .topo__painel, .topo__veu { display: none; }
    /* Divisória fina entre os links e o botão */
    .topo__acoes {
      gap: 0;
      margin-left: var(--s-6);
      padding-left: var(--s-6);
      background: linear-gradient(var(--line), var(--line)) left center / 1px 24px no-repeat;
    }
    .topo__acoes :global(.botao) { padding: 0 16px 0 18px; font-size: 0.9375rem; }
  }
</style>
