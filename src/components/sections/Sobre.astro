---
/*
  §13 Sobre. Uma ficha de quem faz: o retrato é um encaixe do painel reservado para a foto
  profissional (ainda não existe; a foto de perfil foi descartada para o site), com a grade
  fina por dentro, o símbolo B em marca d'água e marcas de enquadramento em 90° nos cantos
  retos. No celular o encaixe fica pequeno, ao lado do nome, como num crachá; no computador,
  em 4:5 à esquerda, com o texto centrado na altura dele. O único ciano é o botão do WhatsApp.
  Sem números (anos, projetos): copy §13.
*/
import Secao from "../ui/Secao.astro";
import Rotulo from "../ui/Rotulo.astro";
import Botao from "../ui/Botao.astro";
import simbolo from "../../assets/logo/simbolo-escuro.svg?raw";
import { sobre } from "../../content/home";
import { montarLinkWhatsapp } from "../../lib/whatsapp";
---
<Secao id="sobre" tema="elevado" class="sobre">
  <div class="sobre__grade">
    {/* Espaço reservado da foto: só visual, sem texto (copy §13) */}
    <div class="sobre__retrato chanfrado" aria-hidden="true">
      <span class="sobre__fundo grade"></span>
      <span class="sobre__simbolo" set:html={simbolo} />
      <span class="sobre__marca sobre__marca--topo"></span>
      <span class="sobre__marca sobre__marca--base"></span>
    </div>

    <header class="sobre__cabeca">
      <Rotulo>{sobre.rotulo}</Rotulo>
      <h2 class="sobre__titulo">{sobre.titulo}</h2>
    </header>

    <div class="sobre__corpo" data-revela>
      {sobre.paragrafos.map((paragrafo) => <p class="sobre__texto">{paragrafo}</p>)}
      <div class="sobre__acoes">
        <Botao variante="secundario" href="/quem-sou" icone="seta">{sobre.botaoHistoria}</Botao>
        <Botao href={montarLinkWhatsapp("sobre")} icone="whatsapp" origem="sobre">{sobre.botaoWhatsapp}</Botao>
      </div>
    </div>
  </div>
</Secao>

<style>
  /* Celular: o encaixe pequeno ao lado do nome; o texto embaixo, na largura toda */
  .sobre__grade {
    --retrato: clamp(96px, 29vw, 132px);
    display: grid;
    grid-template-columns: var(--retrato) minmax(0, 1fr);
    grid-template-areas:
      "retrato cabeca"
      "corpo corpo";
    column-gap: var(--s-5);
    min-width: 0;
  }

  /* ---------- O encaixe do retrato ---------- */
  .sobre__retrato {
    --c: var(--chanfro);
    --cor-borda: var(--line);
    --cor-fundo: var(--surface);
    --marca: 10px;
    --marca-recuo: 8px;
    grid-area: retrato;
    align-self: end;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  /* Grade fina por dentro (utilitário .grade), seguindo o recorte do encaixe */
  .sobre__fundo {
    --grade-passo: 16px;
    --grade-cor: color-mix(in srgb, var(--line) 75%, transparent);
    --grade-origem: center center;
    --grade-mascara: radial-gradient(ellipse 85% 70% at 50% 50%, #000 15%, transparent 100%);
    position: absolute;
    inset: 1px;
    pointer-events: none;
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
  }

  /* O símbolo em marca d'água: cor e forma originais, só bem apagado */
  .sobre__simbolo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0.09;
    pointer-events: none;
  }
  .sobre__simbolo :global(svg) { width: 52%; height: auto; }

  /* Marcas de enquadramento em 90°, nos dois cantos retos do encaixe */
  .sobre__marca {
    position: absolute;
    width: var(--marca);
    height: var(--marca);
    pointer-events: none;
  }
  .sobre__marca--topo {
    top: var(--marca-recuo);
    right: var(--marca-recuo);
    border-top: 1px solid var(--line-forte);
    border-right: 1px solid var(--line-forte);
  }
  .sobre__marca--base {
    bottom: var(--marca-recuo);
    left: var(--marca-recuo);
    border-bottom: 1px solid var(--line-forte);
    border-left: 1px solid var(--line-forte);
  }

  /* ---------- O texto ---------- */
  .sobre__cabeca {
    grid-area: cabeca;
    align-self: end;
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    min-width: 0;
  }
  .sobre__titulo {
    max-width: 16ch;
    font-size: var(--t-h1);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .sobre__corpo {
    grid-area: corpo;
    display: grid;
    gap: var(--s-4);
    min-width: 0;
    margin-top: var(--s-6);
  }
  .sobre__texto {
    max-width: 60ch;
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: var(--ink);
  }

  .sobre__acoes {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }
  .sobre__acoes :global(.botao) { width: 100%; }

  @media (min-width: 640px) {
    .sobre__acoes { display: flex; flex-wrap: wrap; }
    .sobre__acoes :global(.botao) { width: auto; }
  }

  @media (min-width: 720px) {
    .sobre__grade { --retrato: 168px; column-gap: var(--s-6); }
    .sobre__retrato { --c: var(--chanfro-lg); --marca: 14px; --marca-recuo: 12px; }
  }

  /*
    Computador: o encaixe em 4:5 nas colunas 1–5 e o texto nas 6–12, centrado na altura dele
    (as linhas de cima e de baixo da grade são folgas iguais). Se o texto for mais alto, como
    perto de 960 px, é o encaixe que se centra nele.
  */
  @media (min-width: 960px) {
    .sobre__grade {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: none;
      column-gap: var(--s-5);
    }
    .sobre__retrato {
      grid-column: 1 / span 5;
      grid-row: 1 / -1;
      align-self: center;
      --marca: 18px;
      --marca-recuo: 16px;
    }
    .sobre__fundo { --grade-passo: 32px; }
    .sobre__simbolo :global(svg) { width: 38%; }
    /* O texto começa na coluna 6, recuado: os dois botões cabem lado a lado em 1440 */
    .sobre__cabeca { grid-column: 6 / -1; grid-row: 2; padding-left: var(--s-7); }
    .sobre__corpo { grid-column: 6 / -1; grid-row: 3; margin-top: var(--s-6); padding-left: var(--s-7); }
    .sobre__titulo { max-width: 20ch; }
  }
</style>
