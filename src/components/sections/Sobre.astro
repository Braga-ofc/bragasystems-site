---
/*
  Sobre (copy 2.9): logo depois da Dor, em fundo claro azul-gelo, a pessoa por trás da página:
  nome, missão e valor. A foto (braços cruzados, desde 29/10/2026) fica na moldura do "Quem sou eu?"
  do site da EBEN, pedida pelo Gustavo e trazida para a marca: o retrato num círculo, cercado por um
  mostrador de marcas em ciano, por "BRAGA · SYSTEMS" escrito em volta (como na foto de perfil), por
  um aro deslocado em órbita, por losangos que piscam, por um halo ciano e por duas ondas tracejadas.
  Cada camada gira devagar para um lado (a pausa fora da tela e na rolagem é a de scripts/animacoes).
  Ao aparecer, a íris abre do centro com um aro aceso, a foto sai de um zoom fechado e as camadas
  entram girando mais rápido até a volta lenta. No celular vem acima do nome, centrada; no computador,
  à esquerda. Fundo: dobras de luz e fios em ciano que deslizam devagar (a partir do "Background
  premium" do Gustavo, redesenhado nas cores da marca). As bordas de cima e de baixo escurecem até
  o preto, para a passagem da Dor e para a Proposta ser contínua. O único botão é o da história.
*/
import Secao from "../ui/Secao.astro";
import { Image } from "astro:assets";
import foto from "../../assets/gustavo/gustavo-braga-bracos-cruzados.jpg";
import { sobre } from "../../content/home";
import { rich } from "../../lib/texto";

// "pré-venda" leva o marca-texto (pedido do Gustavo, 19/10/2026); se a copy mudar, sai sem o destaque.
const paragrafos = sobre.paragrafos.map((p) => rich(p).replace("pré-venda", '<mark data-marca="pronta">$&</mark>'));

// Losangos em volta do retrato: posição, tamanho e cor de cada um (os mesmos lugares das estrelas da EBEN)
const brilhos = [
  "top:6%;right:8%;--tam:22px",
  "top:14%;left:4%;--tam:10px;--cor:var(--ink)",
  "bottom:10%;left:6%;--tam:16px;--cor:var(--ink)",
  "right:2%;bottom:22%;--tam:12px",
];
---
<Secao id="sobre" tema="claro" class="sobre">
  <div class="sobre__ceu" aria-hidden="true">
    <span class="sobre__dobra sobre__dobra--1"></span>
    <span class="sobre__dobra sobre__dobra--2"></span>
    <span class="sobre__dobra sobre__dobra--3"></span>
    <span class="sobre__traco sobre__traco--1"></span>
    <span class="sobre__traco sobre__traco--2"></span>
    <span class="sobre__traco sobre__traco--3"></span>
    <span class="sobre__traco sobre__traco--4"></span>
  </div>
  <div class="sobre__grade">
    <div class="sobre__palco" data-moldura>
      {/* De fora para dentro, cada camada gira para um lado: horário, anti-horário, horário... */}
      <span class="sobre__deco sobre__gira sobre__gira--longe sobre__onda sobre__onda--longe" aria-hidden="true"></span>
      <span class="sobre__deco sobre__gira sobre__gira--perto sobre__gira--anti sobre__onda sobre__onda--perto" aria-hidden="true"></span>
      <span class="sobre__deco sobre__gira sobre__gira--halo sobre__halo" aria-hidden="true"></span>

      <svg viewBox="0 0 400 400" class="sobre__deco sobre__mostrador" aria-hidden="true" focusable="false">
        <defs>
          <path id="sobre-anel" d="M 200 200 m -160 0 a 160 160 0 1 1 320 0 a 160 160 0 1 1 -320 0" />
        </defs>
        <g class="sobre__gira sobre__gira--marcas">
          <circle cx="200" cy="200" r="188" pathLength="120" class="sobre__marcas" />
          <circle cx="200" cy="200" r="188" pathLength="12" class="sobre__marcas sobre__marcas--grandes" />
        </g>
        <g class="sobre__gira sobre__gira--texto sobre__gira--anti">
          <text class="sobre__anel-texto">
            <textPath href="#sobre-anel" textLength="1000" lengthAdjust="spacing">BRAGA · SYSTEMS · BRAGA · SYSTEMS · BRAGA · SYSTEMS · </textPath>
          </text>
        </g>
      </svg>

      <span class="sobre__deco sobre__gira sobre__gira--orbita sobre__orbita" aria-hidden="true"><span class="sobre__aro"></span></span>

      <div class="sobre__retrato">
        <Image
          class="sobre__foto"
          src={foto}
          alt={sobre.retratoAlt}
          widths={[260, 400, 520, 800]}
          sizes="(min-width: 960px) 400px, (min-width: 720px) 210px, min(250px, 64vw)"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      </div>

      <span class="sobre__deco sobre__gira sobre__gira--brilhos sobre__gira--anti sobre__brilhos" aria-hidden="true">
        {brilhos.map((estilo, i) => <i class={"sobre__brilho sobre__brilho--" + (i + 1)} style={estilo}></i>)}
      </span>
    </div>

    <header class="sobre__cabeca">
      <h2 class="sobre__titulo foco-rolagem">{sobre.titulo}</h2>
    </header>

    <div class="sobre__corpo">
      {paragrafos.map((paragrafo) => <p class="sobre__texto sobe-rolagem" set:html={paragrafo} />)}
      <!-- Único botão da seção (pedido do Gustavo): base do cssbuttons-io-button (Uiverse), nas cores e no chanfro da marca -->
      <a class="sobre__historia" href="/quem-sou">
        <span class="sobre__historia-texto">{sobre.botaoHistoria}</span>
        <span class="sobre__historia-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    </div>
  </div>

  {/* O script fica dentro da Secao: fora dela, quebraria a linha divisória entre seções */}
  <script>
    // A íris abre uma vez, quando a moldura aparece. Só arma se ela ainda estiver abaixo da tela.
    const palco = document.querySelector<HTMLElement>("[data-moldura]");
    if (palco && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window && palco.getBoundingClientRect().top > innerHeight) {
      palco.dataset.moldura = "pronta";
      const observador = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          observador.disconnect();
          palco.dataset.moldura = "aberta";
        },
        { threshold: 0.35 },
      );
      observador.observe(palco);
    }
  </script>
</Secao>

<style>
  /* Celular: a foto acima do nome; o texto embaixo, na largura toda */
  .sobre__grade {
    /* O palco pode passar um pouco da coluna no celular: as marcas (raio 188 de 400) ainda cabem na tela */
    --retrato: min(380px, 106%);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "retrato"
      "cabeca"
      "corpo";
    row-gap: var(--s-6);
    min-width: 0;
  }

  /* ---------- A moldura do retrato (a do "Quem sou eu?" da EBEN, nas cores da marca) ----------
     Medidas em porcentagem do palco: retrato com 65% (raio 130 no desenho de 400), texto no raio 160
     e marcas no raio 188. As ondas passam da borda do palco; a seção corta o que sai dela. */
  .sobre__palco {
    grid-area: retrato;
    justify-self: center;
    position: relative;
    width: var(--retrato);
    aspect-ratio: 1;
  }
  .sobre__deco { position: absolute; pointer-events: none; }

  .sobre__onda {
    top: 50%;
    left: 50%;
    aspect-ratio: 1;
    border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    translate: -50% -50%;
  }
  .sobre__onda--perto { width: 122%; }
  .sobre__onda--longe {
    width: 150%;
    border-style: dotted;
    border-width: 2px;
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  /* Halo atrás do retrato: ciano elétrico e ciano profundo em fatias, para a volta aparecer.
     Sem filter blur (trava o computador): a máscara radial já apaga as bordas. */
  .sobre__halo {
    inset: 4%;
    border-radius: 999px;
    background: conic-gradient(
      rgb(53 213 232 / 0.75),
      transparent 22%,
      rgb(9 106 120 / 0.55) 40%,
      transparent 62%,
      rgb(53 213 232 / 0.6) 80%,
      rgb(53 213 232 / 0.75)
    );
    -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 70%);
    mask-image: radial-gradient(circle, #000 30%, transparent 70%);
    opacity: 0.6;
  }

  .sobre__mostrador { inset: 0; width: 100%; height: 100%; overflow: visible; }
  .sobre__marcas {
    fill: none;
    stroke: var(--accent);
    stroke-width: 7;
    stroke-dasharray: 0.12 0.88;
    opacity: 0.5;
  }
  .sobre__marcas--grandes { stroke-width: 16; stroke-dasharray: 0.03 0.97; opacity: 0.9; }
  .sobre__anel-texto {
    fill: var(--ink);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3em;
  }

  /* O aro do tamanho do retrato, deslocado: ao girar, ele orbita a foto */
  .sobre__orbita { inset: 0; }
  .sobre__aro {
    position: absolute;
    inset: 17.5%;
    border: 1px solid var(--accent);
    border-radius: 999px;
    translate: 3% 3%;
  }

  .sobre__retrato {
    position: absolute;
    inset: 17.5%;
    overflow: hidden;
    border-radius: 999px;
    background: var(--surface-sunken);
    box-shadow: 0 0 0 4px var(--surface);
    clip-path: circle(50%);
  }
  /* Aro aceso na borda da íris: cresce junto com a abertura e some no fim */
  .sobre__retrato::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid var(--accent);
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
  }
  /* Foto quadrada: do cabelo aos braços cruzados, com zoom leve centrado no rosto */
  .sobre__retrato :global(.sobre__foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    transform-origin: 45% 30%;
    scale: 1.12;
  }

  .sobre__brilhos { inset: 0; }
  .sobre__brilho {
    position: absolute;
    width: var(--tam);
    aspect-ratio: 1;
    background: var(--cor, var(--accent));
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  /* Rotação das camadas: --dir dá o sentido, --volta o tempo de uma volta lenta e --arranque o
     quanto a camada gira a mais na entrada */
  .sobre__gira { --dir: 1; --volta: 120s; --arranque: 160deg; }
  .sobre__gira--anti { --dir: -1; }
  .sobre__gira--longe { --volta: 200s; --arranque: 90deg; }
  .sobre__gira--perto { --volta: 150s; --arranque: 120deg; }
  .sobre__gira--halo { --volta: 40s; --arranque: 200deg; }
  .sobre__gira--marcas { --volta: 110s; --arranque: 180deg; }
  .sobre__gira--texto { --volta: 90s; --arranque: 200deg; }
  .sobre__gira--orbita { --volta: 45s; --arranque: 240deg; }
  .sobre__gira--brilhos { --volta: 80s; --arranque: 150deg; }
  /* Dentro do SVG, o centro da volta é o centro do desenho */
  .sobre__mostrador .sobre__gira { transform-box: view-box; transform-origin: center; }

  @media (prefers-reduced-motion: no-preference) {
    /* Antes da entrada: íris fechada, foto bem perto e camadas apagadas e recolhidas */
    .sobre__palco[data-moldura="pronta"] .sobre__retrato { clip-path: circle(0%); }
    .sobre__palco[data-moldura="pronta"] :global(.sobre__foto) { scale: 1.6; }
    .sobre__palco[data-moldura="pronta"] .sobre__deco { opacity: 0; scale: 0.9; }

    /* A entrada: a íris abre em 1,6 s, a foto se afasta em 2,4 s e as camadas acendem */
    .sobre__palco[data-moldura="aberta"] .sobre__retrato { transition: clip-path 1.6s var(--ease-saida) 0.1s; }
    .sobre__palco[data-moldura="aberta"] .sobre__retrato::after {
      animation: sobre-aro-cresce 1.6s var(--ease-saida) 0.1s both, sobre-aro-some 1.9s linear 0.1s both;
    }
    .sobre__palco[data-moldura="aberta"] :global(.sobre__foto) {
      transition: scale 2.4s var(--ease-saida) 0.1s, transform 1.2s var(--ease-saida);
    }
    .sobre__palco[data-moldura="aberta"] .sobre__deco { transition: opacity 1.2s ease 0.2s, scale 1.8s var(--ease-saida) 0.2s; }

    /* A volta lenta roda sempre; a entrada soma uma volta rápida que desacelera até o ritmo lento */
    .sobre__gira { animation: sobre-volta var(--volta) linear infinite; }
    .sobre__palco[data-moldura="aberta"] .sobre__gira {
      animation: sobre-volta var(--volta) linear infinite, sobre-arranque 3.2s var(--ease-saida) both;
    }

    .sobre__brilho { animation: sobre-pisca 2.8s ease-in-out infinite alternate; }
    .sobre__brilho--2 { animation-duration: 2.2s; animation-delay: -0.8s; }
    .sobre__brilho--3 { animation-duration: 3.4s; animation-delay: -1.6s; }
    .sobre__brilho--4 { animation-duration: 2.5s; animation-delay: -2.1s; }

    .sobre__retrato :global(.sobre__foto) { transition: transform 1.2s var(--ease-saida); }
    @media (hover: hover) {
      .sobre__palco:hover :global(.sobre__foto) { transform: scale(1.05); }
    }
  }
  @keyframes sobre-volta { to { transform: rotate(calc(360deg * var(--dir))); } }
  @keyframes sobre-arranque {
    from { rotate: calc(var(--arranque) * var(--dir) * -1); }
    to { rotate: 0deg; }
  }
  @keyframes sobre-aro-cresce { from { scale: 0; } to { scale: 1; } }
  @keyframes sobre-aro-some { 0%, 70% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes sobre-pisca {
    from { opacity: 0.35; scale: 0.6; rotate: 0deg; }
    to { opacity: 1; scale: 1; rotate: 45deg; }
  }
  @media (forced-colors: active) { .sobre__deco { display: none; } }

  /* ---------- O texto ---------- */
  .sobre__cabeca {
    grid-area: cabeca;
    align-self: end;
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    min-width: 0;
  }
  .sobre__titulo {
    max-width: 22ch;
    text-wrap: balance;
    font-size: var(--t-h1);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .sobre__corpo {
    grid-area: corpo;
    display: grid;
    gap: var(--s-4);
    min-width: 0;
  }
  .sobre__texto {
    max-width: 60ch;
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: var(--ink);
  }

  /*
    O único botão (base: cssbuttons-io-button, Uiverse): de ponta a ponta da coluna, com o bloco da
    seta à direita que se estende pelo botão inteiro no hover. Nas cores da marca e com o chanfro em
    45° no lugar do raio. Entrada (pedido do Gustavo): conforme a rolagem, o botão é desenhado da
    esquerda para a direita e o bloco da seta, que começa cobrindo tudo, recua até o canto e revela o
    texto; subindo a página, desfaz. Sem suporte ou com movimento reduzido: já pronto.
  */
  .sobre__historia {
    --c: 12px;
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 60px;
    margin-top: var(--s-5);
    padding: 0 4.4rem 0 1.5rem;
    overflow: hidden;
    color: #fff;
    background: var(--accent);
    box-shadow: inset 0 0 1.6em -0.6em #04434C;
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
    font: 600 1.0625rem/1.2 var(--font-sans);
    letter-spacing: 0.02em;
    text-decoration: none;
    view-timeline: --historia block;
  }
  .sobre__historia-texto { position: relative; }
  /*
    O bloco da seta ocupa o botão todo e é recortado até os 48 px da direita; crescer é só mexer no
    recorte (--abre), sem mudar a largura: nada no layout se move (CLS 0).
  */
  @property --abre { syntax: "<length-percentage>"; inherits: false; initial-value: 0px; }
  .sobre__historia-icone {
    --abre: calc(100% - 48px);
    position: absolute;
    inset: 6px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 13px;
    container-type: inline-size;
    color: var(--accent);
    background: #fff;
    clip-path: polygon(calc(var(--abre) + 8px) 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, var(--abre) 100%, var(--abre) 8px);
    transition: --abre 300ms var(--ease-saida), transform 150ms var(--ease-saida);
  }
  .sobre__historia-icone svg { width: 22px; height: 22px; transition: transform 300ms var(--ease-saida); }
  .sobre__historia:hover .sobre__historia-icone,
  .sobre__historia:focus-visible .sobre__historia-icone { --abre: 0px; }
  /* No hover a seta vai até o meio do botão: o centro dela está a 24 px da borda direita */
  .sobre__historia:hover .sobre__historia-icone svg,
  .sobre__historia:focus-visible .sobre__historia-icone svg { transform: translateX(calc(-50cqw + 24px)); }
  .sobre__historia:active .sobre__historia-icone { transform: scale(0.97); }
  .sobre__historia:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sobre__historia {
        animation: historia-desenha linear both;
        animation-timeline: --historia;
        animation-range: entry 0% cover 15%;
      }
      .sobre__historia-icone {
        animation: historia-recua linear both;
        animation-timeline: --historia;
        animation-range: cover 12% cover 26%;
      }
      .sobre__historia-texto {
        animation: historia-texto linear both;
        animation-timeline: --historia;
        animation-range: cover 18% cover 30%;
      }
    }
  }
  /* No notebook e no computador a entrada começa um pouco antes (a pedido do Gustavo) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
      .sobre__historia { animation-range: entry 0% entry 100%; }
      .sobre__historia-icone { animation-range: entry 60% cover 14%; }
      .sobre__historia-texto { animation-range: entry 80% cover 18%; }
    }
  }
  @keyframes historia-desenha {
    from { clip-path: polygon(var(--c) 0, var(--c) 0, var(--c) 100%, var(--c) 100%, 0 100%, 0 var(--c)); }
  }
  @keyframes historia-recua {
    from { --abre: 0px; }
  }
  @keyframes historia-texto {
    from { opacity: 0; translate: -12px 0; filter: blur(4px); }
  }
  @media (forced-colors: active) {
    .sobre__historia { border: 1px solid LinkText; }
  }

  /* ---------- Fundo: dobras de luz e fios em ciano, deslizando devagar ---------- */
  .sobre__ceu {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  /* Passagem contínua: o alto vem do preto da Dor e a base volta ao preto da Proposta */
  .sobre__ceu::before,
  .sobre__ceu::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    z-index: 2;
    height: var(--secao-respiro);
  }
  .sobre__ceu::before { top: 0; background: linear-gradient(#0B0F14, rgb(11 15 20 / 0.55) 35%, transparent); }
  .sobre__ceu::after { bottom: 0; background: linear-gradient(transparent, rgb(11 15 20 / 0.55) 65%, #0B0F14); }

  .sobre__dobra,
  .sobre__traco {
    position: absolute;
    top: -30%;
    height: 160%;
    rotate: 32deg;
    will-change: transform;
  }
  .sobre__dobra { width: 26%; }
  .sobre__dobra--1 { left: -6%; background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.7) 55%, rgb(196 214 238 / 0.55) 56%, rgb(255 255 255 / 0)); }
  .sobre__dobra--2 { left: 34%; width: 34%; background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.55) 60%, rgb(255 255 255 / 0)); }
  .sobre__dobra--3 { left: 76%; background: linear-gradient(90deg, rgb(196 214 238 / 0), rgb(196 214 238 / 0.6) 45%, rgb(255 255 255 / 0.7) 46%, rgb(255 255 255 / 0)); }

  /* Os fios: linhas finas em ciano profundo com o meio aceso, afinando nas pontas */
  .sobre__traco {
    width: 5px;
    background: linear-gradient(transparent 4%, #0B7C8C 22%, #35D5E8 48%, #0B7C8C 74%, transparent 96%);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    opacity: 0.85;
  }
  .sobre__traco--1 { left: 10%; }
  .sobre__traco--2 { left: 4%; top: -10%; width: 3px; opacity: 0.6; }
  .sobre__traco--3 { left: 84%; }
  .sobre__traco--4 { left: 92%; top: -14%; width: 4px; opacity: 0.7; }
  /* No celular os fios cruzam o texto: mais apagados para não disputar com a leitura */
  @media (max-width: 959.98px) { .sobre__traco { opacity: 0.4; } }

  @media (prefers-reduced-motion: no-preference) {
    .sobre__traco--1 { animation: sobre-desliza 16s ease-in-out infinite alternate; }
    .sobre__traco--2 { animation: sobre-desliza 21s ease-in-out -6s infinite alternate-reverse; }
    .sobre__traco--3 { animation: sobre-desliza 18s ease-in-out -3s infinite alternate; }
    .sobre__traco--4 { animation: sobre-desliza 24s ease-in-out -9s infinite alternate-reverse; }
    .sobre__dobra--1 { animation: sobre-dobra 30s ease-in-out infinite alternate; }
    .sobre__dobra--3 { animation: sobre-dobra 36s ease-in-out -12s infinite alternate-reverse; }
  }
  /* Desliza ao longo da própria diagonal (o rotate fica no eixo do elemento) */
  @keyframes sobre-desliza {
    from { transform: translateY(-9%); }
    to { transform: translateY(9%); }
  }
  @keyframes sobre-dobra {
    from { transform: translateX(-4%); }
    to { transform: translateX(4%); }
  }
