---
/*
  Hero (copy §2): a oferta numa frase, as vagas contadas de verdade e o WhatsApp a um toque.
  Vive dentro da .abertura (src/pages/index.astro), que cuida da largura, da grade e do respiro.
  Linha de leitura: medidor das 5 vagas ligado ao selo por um traço fino.
  A headline se decifra uma vez ao carregar (scripts/decifra.ts).
*/
import Botao from "../ui/Botao.astro";
import Selo from "../ui/Selo.astro";
import MedidorVagas from "../ui/MedidorVagas.astro";
import { hero } from "../../content/home";
import { montarLinkWhatsapp } from "../../lib/whatsapp";

interface Props {
  /** Vagas do último build (ou o máximo, se não deu para ler). O contador atualiza ao vivo. */
  vagas: number;
}
const { vagas } = Astro.props;
---
<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="hero__leitura">
    <MedidorVagas tamanho="sm" class="hero__medidor" />
    <span class="hero__traco" aria-hidden="true"></span>
    <Selo tipo="vagas" estado="auto" vagas={vagas} class="hero__selo" />
  </div>

  <h1 id="hero-titulo" class="hero__titulo" data-decifra>{hero.titulo}</h1>
  <p class="hero__subtitulo">{hero.subtitulo}</p>

  <div class="hero__acoes">
    <Botao href={montarLinkWhatsapp("hero")} icone="whatsapp" origem="hero">{hero.botaoPrincipal}</Botao>
    <Botao variante="secundario" href="#projetos" icone="seta">{hero.botaoSecundario}</Botao>
  </div>

  <ul class="hero__micro" role="list">
    {hero.microcopy.map((frase) => <li>{frase}</li>)}
  </ul>
</section>

<script>
  import "../../scripts/decifra";
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* Halo ciano bem suave atrás da headline, sem animação (detalhe permitido no hero) */
  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 8%;
    left: -12%;
    width: 92%;
    height: 62%;
    pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brilho) 42%, transparent), transparent);
  }

  /* Linha de leitura: medidor + traço em cima, selo embaixo (celular); tudo numa linha (computador) */
  .hero__leitura {
    display: grid;
    grid-template-columns: auto minmax(var(--s-5), 1fr);
    grid-template-areas:
      "medidor traco"
      "selo selo";
    align-items: center;
    gap: var(--s-3);
    width: 100%;
  }
  .hero__leitura :global(.hero__medidor) { grid-area: medidor; }
  .hero__traco { grid-area: traco; height: 1px; background: var(--line); }
  .hero__leitura :global(.hero__selo) {
    grid-area: selo;
    justify-self: start;
    max-width: 100%;
    white-space: normal;
  }
  /* Em telas de 360 px o selo cheio não cabe com o espaçamento padrão */
  @media (max-width: 374.98px) {
    .hero__leitura :global(.hero__selo) { letter-spacing: 0.01em; padding-inline: 10px 12px; gap: 8px; }
  }

  /*
    Headline em display, 4 linhas no celular (contrato, FIRST VIEWPORT). A frase quebra em 4 linhas
    enquanto a coluna tem entre ~8,0 e ~8,8 vezes o tamanho da letra; por isso, só aqui, o tamanho
    acompanha a largura da tela (≈ coluna ÷ 8,4 de 320 a 540 px) e para nos 56 px do tokens.json.
  */
  .hero__titulo {
    margin-top: var(--s-6);
    max-width: 16ch;
    font-size: clamp(2rem, 11.4vw - 0.1875rem, 3.5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ink-strong);
  }
  /* Letras criadas pelo decifra.ts enquanto a headline se resolve */
  .hero__titulo :global(.decifra__palavra) { white-space: nowrap; }
  .hero__titulo :global(.decifra__letra) { display: inline-block; text-align: center; }
  .hero__titulo :global(.decifra__letra[data-cifrada]) { color: var(--ink-muted); }

  .hero__subtitulo {
    margin-top: var(--s-5);
    max-width: 46ch;
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: var(--ink);
  }

  /* Botões: empilhados em largura total no celular, lado a lado a partir de 480 px */
  .hero__acoes {
    display: grid;
    gap: var(--s-3);
    width: 100%;
    margin-top: var(--s-7);
  }
  .hero__acoes :global(.botao) { width: 100%; }

  /* Microcopy: leitura em mono; as duas frases separadas por um ponto quadrado */
  .hero__micro {
    display: grid;
    gap: var(--s-1);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
    font: 500 var(--t-label)/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  @media (min-width: 480px) {
    .hero__acoes { display: flex; flex-wrap: wrap; width: auto; }
    .hero__acoes :global(.botao) { width: auto; }
    .hero__micro { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-3); }
    .hero__micro li + li { display: inline-flex; align-items: center; gap: var(--s-3); }
    .hero__micro li + li::before { content: ""; width: 3px; height: 3px; background: currentColor; }
  }

  @media (min-width: 720px) {
    .hero__leitura {
      grid-template-columns: auto var(--s-5) auto;
      grid-template-areas: "medidor traco selo";
      justify-content: start;
    }
    .hero__titulo { margin-top: var(--s-7); }
  }

  @media (min-width: 1024px) {
    .hero { padding-right: var(--s-5); }
    .hero::before { top: 6%; left: -18%; width: 96%; height: 60%; }
  }
</style>
