---
/*
  §17 PS. Um pós-escrito de carta: o "PS:" pendurado na margem, uma régua fina com corte em 45°
  descendo pela margem até o botão. Três variantes conforme o contador (mapa técnico, arquivo 03).
*/
import Secao from "../ui/Secao.astro";
import Botao from "../ui/Botao.astro";
import { ps } from "../../content/home";
import { comVagas, rich } from "../../lib/texto";
import { montarLinkWhatsapp } from "../../lib/whatsapp";

interface Props {
  vagas: number;
}
const { vagas } = Astro.props;

// O espaço depois do "PS:" entra no próprio rótulo pendurado, para o texto alinhar na margem.
const pendurar = (html: string) => html.replace(/^<strong>(.*?)<\/strong> /, "<strong>$1 </strong>");
---
<Secao largura="estreita">
  <div class="ps" data-revela>
    <p class="ps__texto" data-quando-vagas="com" set:html={pendurar(comVagas(rich(ps.texto), vagas))} />
    <p class="ps__texto" data-quando-vagas="esgotado" set:html={pendurar(rich(ps.textoSemVagas))} />
    <p class="ps__texto" data-quando-vagas="falha" set:html={pendurar(rich(ps.textoSemNumero))} />

    <div class="ps__acao">
      <span class="ps__botao" data-quando-vagas="com falha">
        <Botao href={montarLinkWhatsapp("urgencia")} icone="whatsapp" origem="urgencia">{ps.botao}</Botao>
      </span>
      {/* Sem vagas, a mensagem de fundador não serve: vai a mensagem geral, como na Urgência (§14). */}
      <span class="ps__botao" data-quando-vagas="esgotado">
        <Botao href={montarLinkWhatsapp("topo")} icone="whatsapp" origem="urgencia">{ps.botao}</Botao>
      </span>
    </div>
  </div>
</Secao>

<style>
  .ps {
    --ps-margem: 2.75rem;
    --ps-linha: 1.6;
    position: relative;
    padding-left: var(--ps-margem);
    font-size: var(--t-body-lg);
  }

  /* A régua da margem: começa logo abaixo do "PS:" com um corte em 45° e desce até o botão */
  .ps::before,
  .ps::after {
    content: "";
    position: absolute;
    left: 0;
    pointer-events: none;
  }
  .ps::before {
    top: calc(1em * var(--ps-linha) + var(--s-2) + 11px);
    bottom: 0;
    width: 1px;
    background: var(--line-forte);
  }
  .ps::after {
    top: calc(1em * var(--ps-linha) + var(--s-2));
    width: 12px;
    height: 12px;
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 0.75px),
      var(--line-forte) calc(50% - 0.75px) calc(50% + 0.75px),
      transparent calc(50% + 0.75px)
    );
  }

  .ps__texto {
    max-width: 62ch;
    line-height: var(--ps-linha);
    color: var(--ink);
  }
  .ps__texto :global(strong) { font-weight: 600; color: var(--ink-strong); }
  /* O "PS:" sai do texto e fica pendurado na margem, na mesma linha de base */
  .ps__texto :global(strong:first-child) {
    display: inline-block;
    width: var(--ps-margem);
    margin-left: calc(-1 * var(--ps-margem));
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  .ps__acao { margin-top: var(--s-6); }
  .ps__botao { display: block; }
  .ps__botao :global(.botao) { width: 100%; }

  @media (min-width: 640px) {
    .ps { --ps-margem: 3.5rem; font-size: var(--t-h3); }
    .ps__botao :global(.botao) { width: auto; }
  }
</style>
