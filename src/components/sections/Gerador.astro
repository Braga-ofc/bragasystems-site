---
/*
  §3 Gerador de headline com IA: o console do painel, o carro-chefe da primeira dobra. Vive dentro
  da .abertura (index.astro), ao lado do Hero no computador e logo abaixo dele no celular.
  Estados em data-estado: inicial | carregando | resultado | enviado. Todos já estão no HTML;
  quem troca é scripts/gerador.ts. Sem JavaScript, o formulário faz POST (nada vai para a URL).
  Movimento em data-entrada: espera | ligando | pronta (script inline logo após o console). O painel
  "liga" uma vez ao aparecer e depois fica vivo só enquanto está na tela; regras no fim do CSS.
*/
import Campo from "../ui/Campo.astro";
import Botao from "../ui/Botao.astro";
import Icone from "../ui/Icone.astro";
import Rotulo from "../ui/Rotulo.astro";
import { ctaFinal, gerador } from "../../content/home";
import { comLinkPrivacidade } from "../../lib/texto";
import { montarLinkWhatsapp } from "../../lib/whatsapp";

const linkWhatsapp = montarLinkWhatsapp("gerador");

// Na mensagem de limite, o trecho final da copy vira link para o WhatsApp.
const trechoLink = "Fale comigo no WhatsApp.";
const posLink = gerador.erros.limite.indexOf(trechoLink);
const limite =
  posLink >= 0
    ? { antes: gerador.erros.limite.slice(0, posLink), link: trechoLink, depois: gerador.erros.limite.slice(posLink + trechoLink.length) }
    : { antes: gerador.erros.limite, link: "", depois: "" };

const [rodapeIa, rodapeLimite] = gerador.rodape;

// Palavras com hífen (Pré-Venda) não quebram no meio do título.
const tituloPartes = gerador.titulo.split(/(\S+-\S+)/).filter(Boolean);
---
<section id="gerador" class="gerador" aria-labelledby="gerador-titulo">
  <div class="console chanfrado feixe" data-gerador data-estado="inicial">
    {/* Luz lenta da borda e o halo dela: só decoração, só com movimento */}
    <span class="console__luz" aria-hidden="true"></span>
    <span class="console__halo" aria-hidden="true"></span>
    <div class="console__zona console__cabeca">
      <h2 id="gerador-titulo" class="console__titulo">
        {tituloPartes.map((parte) => (parte.includes("-") ? <span class="console__inteira">{parte}</span> : parte))}
      </h2>
      <p class="console__texto">{gerador.texto}</p>
    </div>

    {/* Saída: a headline gerada, impressa sobre a grade */}
    <div class="console__zona console__visor">
      <span class="console__visor-grade grade" aria-hidden="true"></span>
      <div class="console__resultado" data-resultado tabindex="-1">
        <Rotulo>{gerador.resultadoRotulo}</Rotulo>
        <p class="console__headline" data-headline></p>
      </div>
    </div>

    {/* Entrada: o que vende e para quem */}
    <form
      class="console__zona console__entrada"
      method="post"
      action="/api/gerar-headline"
      novalidate
      data-gerador-form
      data-erro-vazio={gerador.erros.campoVazio}
    >
      <div class="console__campos">
        <Campo
          id="gerador-vende"
          nome="vende"
          rotulo={gerador.campos.vende.rotulo}
          placeholder={gerador.campos.vende.exemplo}
          maxlength={80}
          obrigatorio
        />
        <Campo
          id="gerador-para-quem"
          nome="paraQuem"
          rotulo={gerador.campos.paraQuem.rotulo}
          placeholder={gerador.campos.paraQuem.exemplo}
          maxlength={80}
          obrigatorio
        />
      </div>
      {/* Próxima etapa: o widget do Turnstile entra aqui; o token segue no pedido (scripts/gerador.ts). */}
      <div class="console__acao">
        <Botao tipo="submit" larguraTotal icone="seta">{gerador.botao}</Botao>
        <p class="console__status" aria-hidden="true">{gerador.carregando}</p>
        <div class="console__aviso" role="alert" data-aviso-geracao></div>
      </div>
    </form>

    {/* Depois do resultado: as outras duas versões pelo WhatsApp */}
    <div class="console__zona console__depois">
      <div class="console__depois-cabeca">
        <h3 class="console__depois-titulo">{gerador.depois.titulo}</h3>
        <p class="console__depois-texto">{gerador.depois.texto}</p>
      </div>
      <form
        class="console__lead"
        method="post"
        action="/api/enviar-lead"
        novalidate
        data-gerador-lead
        data-erro-vazio={ctaFinal.erros.campoVazio}
        data-erro-whatsapp={ctaFinal.erros.whatsappInvalido}
        data-erro-consentimento={gerador.erros.semConsentimento}
      >
        <div class="console__campos">
          <Campo id="gerador-nome" nome="nome" rotulo={gerador.depois.nome} autocomplete="name" maxlength={80} obrigatorio />
          {/* Sem limite de tamanho: a máscara corta em 11 dígitos depois de tirar o +55 (scripts/formulario.ts). */}
          <Campo id="gerador-whatsapp" nome="whatsapp" tipo="telefone" rotulo={gerador.depois.whatsapp} obrigatorio />
        </div>
        <Campo id="gerador-consentimento" nome="consentimento" tipo="consentimento" obrigatorio>
          <Fragment set:html={comLinkPrivacidade(gerador.depois.consentimento)} />
        </Campo>
        {/* Próxima etapa: um novo token do Turnstile entra aqui (memory.md, 18/10/2026). */}
        <div class="console__acao">
          <Botao tipo="submit" larguraTotal icone="whatsapp">{gerador.depois.botao}</Botao>
          <div class="console__aviso" role="alert" data-aviso-lead></div>
        </div>
      </form>
    </div>

    {/* Enviado */}
    <div class="console__zona console__enviado">
      <p class="console__confirmacao" data-confirmacao tabindex="-1">
        <span class="console__check chanfrado" aria-hidden="true"><Icone nome="check" /></span>
        <span>{gerador.confirmacao}</span>
      </p>
    </div>

    <ul class="console__zona console__rodape">
      <li>{rodapeIa}<span class="console__sep" aria-hidden="true">·</span></li>
      <li>{rodapeLimite}</li>
    </ul>

    {/* Anúncios para leitor de tela (carregando) */}
    <p class="sr-only" aria-live="polite" data-anuncio></p>
    <span class="console__varredura" aria-hidden="true"></span>
  </div>
  <script is:inline>
    /*
      Roda antes da primeira pintura: o console nasce apagado (nada pisca) e liga quando o topo dele
      passa da linha de 75% da janela (não depende da altura do console: com zoom de 400% ele é mais
      alto que 4 janelas e nunca ficaria 25% à vista). is-na-tela deixa os loops rodarem só à vista.
      Quem abre já numa âncora (/#planos) não gasta a entrada na rolagem automática: o gatilho só
      liga quando ela termina. Sem JS ou com movimento reduzido, nada muda.
    */
    (() => {
      const painel = document.querySelector("[data-gerador]");
      if (!painel || !("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      painel.dataset.entrada = "espera";
      new IntersectionObserver(([e]) => painel.classList.toggle("is-na-tela", e.isIntersecting)).observe(painel);
      let primeira = true;
      const gatilho = new IntersectionObserver(
        ([e]) => {
          if (painel.dataset.entrada === "espera" && e.isIntersecting) {
            // À vista ao carregar (computador), espera os 300 ms da dobra; ao rolar até ele (celular), liga já.
            if (!primeira) painel.style.setProperty("--ligar", "60ms");
            painel.dataset.entrada = "ligando";
            gatilho.disconnect();
          }
          primeira = false;
        },
        { rootMargin: "0px 0px -25% 0px" },
      );
      const ancora = location.hash && !["#inicio", "#gerador"].includes(location.hash);
      if (!ancora) gatilho.observe(painel);
      else {
        // O navegador pode soltar um scrollend antes da rolagem até a âncora: só vale quando o destino chegou ao topo.
        let ligado = false;
        const observar = () => {
          if (ligado) return;
          ligado = true;
          primeira = false;
          removeEventListener("scrollend", chegou);
          gatilho.observe(painel);
        };
        const chegou = () => {
          const alvo = document.getElementById(decodeURIComponent(location.hash.slice(1)));
          if (!alvo || Math.abs(alvo.getBoundingClientRect().top) < 160) observar();
        };
        addEventListener("scrollend", chegou);
        setTimeout(observar, 3000);
      }
      // O botão acende por último: daí em diante só valem os loops (a entrada não se repete na troca de estado).
      painel.addEventListener("animationend", (evento) => {
        if (evento.animationName === "console-acende") painel.dataset.entrada = "pronta";
      });
    })();
  </script>

  <template data-modelo="limite">
    <p class="console__erro">
      <Icone nome="alerta" tamanho={16} />
      <span>{limite.antes}{limite.link && <a href={linkWhatsapp} target="_blank" rel="noopener" data-origem="gerador">{limite.link}</a>}{limite.depois}</span>
    </p>
  </template>
  <template data-modelo="erro">
    <p class="console__erro"><Icone nome="alerta" tamanho={16} /><span>{gerador.erros.erro}</span></p>
  </template>
  <template data-modelo="falha">
    <div class="console__falha">
      <p class="console__erro"><Icone nome="alerta" tamanho={16} /><span>{ctaFinal.falhaEnvio}</span></p>
      <Botao variante="secundario" href={linkWhatsapp} icone="whatsapp" origem="gerador" larguraTotal>{ctaFinal.falhaBotao}</Botao>
    </div>
  </template>
  <script>
    import "../../scripts/gerador";
  </script>
</section>

<style>
  .gerador {
    container: gerador / inline-size;
    min-width: 0;
  }

  /* O console: moldura chanfrada grande, fundo rebaixado, zonas separadas por linhas finas */
  .console {
    --c: var(--chanfro-lg);
    --cor-borda: var(--line);
    --cor-fundo: var(--surface-sunken);
    --pad: clamp(20px, 7cqi, 32px);
    /* O mesmo recorte da moldura (global.css), para a luz, o halo e a varredura */
    --recorte: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
    /* Quando a entrada começa: 300 ms depois da primeira pintura (o script inline baixa ao rolar) */
    --ligar: 300ms;
    display: flex;
    flex-direction: column;
  }
  .console__zona {
    margin: 0;
    padding: var(--pad);
  }
  .console__zona + .console__zona { border-top: 1px solid var(--line); }

  /* Cabeça */
  .console__cabeca {
    display: grid;
    gap: var(--s-3);
    padding-top: calc(var(--pad) + 4px);
  }
  .console__titulo {
    max-width: 22ch;
    font: 600 var(--t-h2)/1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink-strong);
  }
  .console__inteira { white-space: nowrap; }
  /* Cursor de "sistema pronto" depois do título: o espaço fica sempre reservado (nada pula quando pisca) */
  .console__titulo::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 0.86em;
    margin-left: 0.14em;
    margin-right: calc(-2px - 0.14em);
    vertical-align: -0.06em;
    background: var(--accent);
    opacity: 0;
  }
  .console__texto {
    max-width: 52ch;
    color: var(--ink-muted);
  }

  /* Entrada */
  .console__entrada {
    display: grid;
    gap: var(--s-5);
  }
  .console__campos {
    display: grid;
    gap: var(--s-4);
  }

  /* Botão, leitura do "carregando" e aviso: um bloco só, sem espaço vazio quando não há aviso */
  .console__acao { display: grid; }

  /* Leitura do "carregando": mono, logo abaixo do botão */
  .console__status {
    display: none;
    align-items: center;
    gap: 10px;
    margin-top: var(--s-4);
    font: 400 var(--t-small)/1.4 var(--font-mono);
    color: var(--ink);
  }
  .console__status::before {
    content: "";
    width: 12px;
    height: 8px;
    flex: none;
    background: var(--ink-strong);
    clip-path: polygon(0 0, 50% 0, 100% 100%, 50% 100%);
  }

  /* Avisos (role="alert"): ficam sempre no HTML, vazios até haver o que dizer */
  .console__aviso:not(:empty) { margin-top: var(--s-4); }
  .console__erro {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--erro);
  }
  .console__erro :global(svg) { margin-top: 1px; }
  .console__erro a { color: var(--ink-strong); text-decoration-color: var(--line-forte); }
  .console__erro a:hover { color: var(--accent); text-decoration-color: currentColor; }
  .console__falha { display: grid; gap: var(--s-4); }
  .console__falha .console__erro { font: 500 var(--t-body)/1.45 var(--font-sans); color: var(--ink-strong); }
  .console__falha .console__erro :global(svg) { margin-top: 3px; color: var(--erro); }

  /* Saída: a headline gerada sobre a grade fina, que se dissolve para a direita */
  .console__visor {
    position: relative;
    display: none;
    overflow: hidden;
    padding-block: calc(var(--pad) + 4px);
  }
  .console__visor-grade {
    position: absolute;
    inset: 0;
    --grade-origem: left top;
    --grade-mascara: radial-gradient(ellipse 120% 160% at 0% 0%, #000 15%, transparent 78%);
  }
  .console__resultado {
    position: relative;
    display: grid;
    gap: var(--s-4);
  }
  /* Recebe o foco do script (não é um controle): sem contorno */
  .console__resultado:focus { outline: none; }
  .console__headline {
    max-width: 24ch;
    font: 600 clamp(1.625rem, 1rem + 3.4cqi, 2.25rem)/1.12 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--ink-strong);
    /* A frase vem da IA, com tamanho variável: "pretty" evita a linha curta no meio */
    text-wrap: pretty;
  }
  /* Digitando: o texto inteiro já está no lugar (nada pula) e as letras acendem em ordem */
  .console__headline :global(.console__letra) { opacity: 0; }
  .console__headline :global(.console__letra[data-on]) { opacity: 1; }
  .console__headline :global(.console__letra[data-cursor]) { position: relative; }
  .console__headline :global(.console__letra[data-cursor]::after) {
    content: "";
    position: absolute;
    top: 0.1em;
    bottom: 0.06em;
    left: calc(100% + 1px);
    width: 2px;
    background: var(--ink-strong);
  }

  /* Depois do resultado */
  .console__depois {
    display: none;
    gap: var(--s-5);
  }
  .console__depois-cabeca { display: grid; gap: var(--s-2); }
  .console__depois-titulo {
    max-width: 26ch;
    font: 500 var(--t-h3)/1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink-strong);
  }
  .console__depois-texto { max-width: 56ch; font-size: var(--t-small); line-height: 1.55; color: var(--ink-muted); }
  .console__lead { display: grid; gap: var(--s-4); }
  .console__lead .console__acao { margin-top: var(--s-1); }
  /* O link da política segue o texto; o ciano do bloco é só o botão */
  .console__lead :global(.check__texto a) { color: var(--ink-strong); text-decoration-color: var(--line-forte); }
  .console__lead :global(.check__texto a:hover) { color: var(--accent); text-decoration-color: currentColor; }

  /* Enviado: o ciano passa do botão para a marca de confirmação */
  .console__enviado { display: none; }
  .console__confirmacao {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
    font: 500 var(--t-h3)/1.35 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink-strong);
  }
  .console__confirmacao:focus { outline: none; }
  .console__check {
    --c: var(--chanfro-sm);
    --cor-borda: var(--accent);
    --cor-fundo: var(--surface-sunken);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    color: var(--accent);
  }

  /* Rodapé: a leitura do bloco em mono */
  .console__rodape {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    padding: 14px calc(var(--pad) + 8px) 16px calc(var(--pad) + 22px);
    list-style: none;
    font: 500 var(--t-label)/1.5 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .console__rodape::before {
    content: "";
    position: absolute;
    top: calc(14px + 0.75em - 4px);
    left: var(--pad);
    width: 12px;
    height: 8px;
    background: var(--line-forte);
    clip-path: polygon(0 0, 50% 0, 100% 100%, 50% 100%);
    transition: background-color var(--dur) var(--ease-saida);
  }
  .console__rodape li { text-wrap: balance; }
  .console__sep { margin-inline: 0.6em; }

  /* ---------- Estados ---------- */
  [data-estado="carregando"] .console__status { display: flex; }
  [data-estado="carregando"] .console__rodape::before,
  [data-estado="resultado"] .console__rodape::before,
  [data-estado="enviado"] .console__rodape::before { background: var(--ink-strong); }

  [data-estado="resultado"] .console__texto,
  [data-estado="enviado"] .console__texto,
  [data-estado="resultado"] .console__entrada,
  [data-estado="enviado"] .console__entrada { display: none; }

  [data-estado="resultado"] .console__visor,
  [data-estado="enviado"] .console__visor { display: block; }
  [data-estado="resultado"] .console__depois { display: grid; }
  [data-estado="enviado"] .console__enviado { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    .console__visor,
    .console__enviado,
    .console__aviso > :global(*),
    .console__status { animation: console-entra var(--dur-lenta) var(--ease-saida) both; }
    .console__depois {
      transition:
        opacity var(--dur-lenta) var(--ease-saida),
        translate var(--dur-lenta) var(--ease-saida),
        visibility 0s linear 0s;
    }
    /* Enquanto a headline é digitada, o pedido do WhatsApp espera, já com o espaço reservado */
    [data-digitando] .console__depois {
      opacity: 0;
      translate: 0 8px;
      visibility: hidden;
      transition: none;
    }
  }
  @keyframes console-entra {
    from { opacity: 0; translate: 0 6px; filter: blur(4px); }
  }

  /*
    ---------- O console vivo (pedido do Gustavo: o carro-chefe da dobra chama atenção) ----------
    Entrada, uma vez (data-entrada="ligando", ~1,2 s depois de --ligar): a moldura se desenha a partir
    do chanfro de cima com uma luz na ponta (Border Beam do Magic UI, MIT, recriado em CSS), as zonas
    sobem do desfoque em cascata, uma varredura ciano desce pelo painel e o botão acende por último.
    Contínua (data-entrada="pronta", só com .is-na-tela, no inicial e no resultado): a luz lenta com
    rodeia a borda (7 s por volta; o halo desfocado só na entrada), a varredura passa a cada 6,5 s, um cursor pisca depois do título
    e o botão respira. No carregando, a luz lenta apaga e o feixe rápido de global.css assume sozinho.
    Tudo anima só cor, opacidade, filtro, translate e ângulos registrados: CLS 0.
  */
  @property --console-traco { syntax: "<angle>"; inherits: true; initial-value: 360deg; }
  @property --console-luz { syntax: "<angle>"; inherits: true; initial-value: 0deg; }

  /* A luz e o halo ficam entre a borda (::before) e o fundo (::after): só aparecem no traço e por fora */
  .console__luz,
  .console__halo,
  .console__varredura {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: none;
    pointer-events: none;
  }
  .console__luz,
  .console__halo::before,
  .console__varredura { clip-path: var(--recorte); }
  /* Cometa: a cabeça ciano forte termina seca na emenda do gradiente; começa no chanfro de cima (-32deg) */
  .console__luz {
    background: conic-gradient(from calc(var(--console-luz) - 32deg), transparent 0 60%, rgb(11 124 140 / 0.55) 84%, var(--ciano-eletrico-forte));
  }
  /*
    O desfoque fica no pai: o filho já vem recortado no chanfro, então o halo segue o canto em 45°.
    O pai sobra 24 px para fora: a máscara da entrada corta na caixa dele, e o halo mora fora da borda.
  */
  .console__halo { inset: -24px; filter: blur(12px); }
  .console__halo::before {
    content: "";
    position: absolute;
    inset: 24px;
    background: conic-gradient(from calc(var(--console-luz) - 32deg), transparent 0 84%, rgb(53 213 232 / 0.4) 94%, var(--ciano-eletrico-forte));
  }
  /* Varredura: linha de 1 px com um rastro fraco acima, por cima do conteúdo e sem pegar clique */
  .console__varredura { z-index: 1; }
  .console__varredura::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    translate: 0 -100%;
    background: linear-gradient(to bottom, transparent calc(100% - 96px), rgb(53 213 232 / 0.08) calc(100% - 1px), rgb(111 227 240 / 0.8) calc(100% - 1px));
  }

  @media (prefers-reduced-motion: no-preference) {
    .console__luz,
    .console__halo,
    .console__varredura { display: block; }
    .console__luz,
    .console__halo {
      opacity: 0;
      transition: opacity var(--dur-lenta) var(--ease-saida);
    }

    /* Espera (celular, abaixo da dobra): só o fundo do painel; moldura e zonas apagadas */
    .console[data-entrada="espera"] { --console-traco: 0deg; }
    .console[data-entrada="espera"] :is(.console__cabeca > *, .console__entrada .console__acao, .console__rodape),
    .console[data-entrada="espera"] .console__entrada .console__campos > :global(*) { opacity: 0; }

    /* Ligando: a moldura, a luz e o halo se revelam juntos, do chanfro em sentido horário */
    .console:is([data-entrada="espera"], [data-entrada="ligando"])::before,
    .console:is([data-entrada="espera"], [data-entrada="ligando"]) :is(.console__luz, .console__halo) {
      -webkit-mask: conic-gradient(from -32deg, #000 var(--console-traco), transparent 0);
      mask: conic-gradient(from -32deg, #000 var(--console-traco), transparent 0);
    }
    .console[data-entrada="ligando"]:not(.feixe--continuo) :is(.console__luz, .console__halo) { opacity: 1; }
    /* Fora do carregando: se o pedido sair durante a entrada, o feixe rápido de global.css vence */
    .console[data-entrada="ligando"]:not(.feixe--continuo)::before,
    .console[data-entrada="ligando"] :is(.console__luz, .console__halo) {
      animation: console-desenha 1160ms cubic-bezier(0.45, 0, 0.2, 1) var(--ligar) both;
    }
    .console[data-entrada="ligando"] .console__varredura::before {
      animation: console-varre-entrada 900ms cubic-bezier(0.4, 0, 0.2, 1) calc(var(--ligar) + 260ms) both;
    }
    .console[data-entrada="ligando"] :is(.console__titulo, .console__texto, .console__rodape),
    .console[data-entrada="ligando"] .console__entrada .console__campos > :global(*) {
      animation: console-zona 600ms var(--ease-saida) calc(var(--ligar) + var(--atraso)) backwards;
    }
    .console__titulo { --atraso: 120ms; }
    .console__texto { --atraso: 200ms; }
    .console__entrada .console__campos > :global(:nth-child(1)) { --atraso: 290ms; }
    .console__entrada .console__campos > :global(:nth-child(2)) { --atraso: 370ms; }
    .console__rodape { --atraso: 540ms; }
    /* O botão sai apagado e cinza, passa do ponto com um halo ciano e assenta: termina junto com a moldura */
    .console[data-entrada="ligando"] .console__entrada .console__acao {
      animation: console-acende 700ms var(--ease-saida) calc(var(--ligar) + 460ms) backwards;
    }

    /*
      Pronta: loops só à vista, e só no inicial e no resultado (no carregando o feixe rápido assume; no
      enviado o painel descansa). O halo desfocado fica só na entrada: refazer o blur do tamanho do
      console a cada quadro dobrava o custo do loop.
    */
    .console[data-entrada="pronta"] .console__halo { display: none; }
    .console[data-entrada="pronta"].is-na-tela:is([data-estado="inicial"], [data-estado="resultado"]):not(.feixe--continuo) .console__luz {
      opacity: 1;
      animation: console-volta 7s linear infinite;
    }
    /* Varredura e cursor somem enquanto alguém digita: nada passa por cima do campo nem dobra o cursor dele */
    .console[data-entrada="pronta"].is-na-tela:is([data-estado="inicial"], [data-estado="resultado"]):not(.feixe--continuo, :has(input:focus)) .console__varredura::before {
      animation: console-varre 6.5s linear infinite;
    }
    .console[data-entrada="pronta"].is-na-tela[data-estado="inicial"]:not(:has(input:focus)) .console__titulo::after {
