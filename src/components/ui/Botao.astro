---
import Icone from "./Icone.astro";

interface Props {
  /** "vitrine": botão de destaque do hero ("Ver projetos"), com efeito próprio (sem Shiny Button). */
  variante?: "primario" | "secundario" | "vitrine";
  href?: string;
  tipo?: "button" | "submit";
  icone?: "whatsapp" | "seta" | "externo" | null;
  carregando?: boolean;
  desativado?: boolean;
  larguraTotal?: boolean;
  /** Abre o link em nova aba (links de WhatsApp já abrem sozinhos). */
  novaAba?: boolean;
  /** Origem do clique de WhatsApp (copy §21), usada na medição. */
  origem?: string;
  /**
    Brilho de CTA (Shiny Button): borda com luz correndo e faixa de luz atravessando.
    Ligado por padrão nos primários e em todo botão que abre o WhatsApp. Os secundários sem
    brilho são de navegação e ganham a borda que se fecha nos cantos (.botao--navega).
    A vitrine nunca leva esse brilho: tem a faixa de luz dela.
  */
  brilho?: boolean;
  /** Neon da borda girando sem parar, aurora no fundo e texto em degradê (WhatsApp do topo). Liga o brilho. */
  sempre?: boolean;
  class?: string;
}

const {
  variante = "primario",
  href,
  tipo = "button",
  icone = null,
  carregando = false,
  desativado = false,
  larguraTotal = false,
  novaAba = false,
  origem,
  brilho,
  sempre = false,
  class: classe,
} = Astro.props;

const ehWhatsapp = href?.startsWith("https://wa.me/");
const abreNovaAba = ehWhatsapp || novaAba;
const comBrilho =
  variante !== "vitrine" && (sempre || (brilho ?? (variante === "primario" || ehWhatsapp))) && !desativado && !carregando;
const navega = variante === "secundario" && !comBrilho && !desativado;
const classes = [
  "botao",
  "chanfrado",
  `botao--${variante}`,
  larguraTotal && "botao--cheio",
  comBrilho && "botao--brilho",
  comBrilho && sempre && "botao--sempre",
  navega && "botao--navega",
  classe,
];
---
{href ? (
  <a
    class:list={classes}
    href={desativado ? undefined : href}
    aria-disabled={desativado ? "true" : undefined}
    aria-busy={carregando ? "true" : undefined}
    target={abreNovaAba ? "_blank" : undefined}
    rel={abreNovaAba ? "noopener" : undefined}
    data-origem={origem}
  >
    <span class="botao__texto"><slot /></span>
    {carregando ? <span class="botao__giro" aria-hidden="true" /> : icone && <Icone nome={icone} class="botao__icone" />}
  </a>
) : (
  <button
    class:list={classes}
    type={tipo}
    disabled={desativado}
    aria-busy={carregando ? "true" : undefined}
    data-origem={origem}
  >
    <span class="botao__texto"><slot /></span>
    {carregando ? <span class="botao__giro" aria-hidden="true" /> : icone && <Icone nome={icone} class="botao__icone" />}
  </button>
)}

<script>
  import "../../scripts/brilho";
</script>

<style>
  .botao {
    --c: var(--chanfro);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px 0 24px;
    border: 0;
    background: none;
    font: 600 1rem/1.2 var(--font-sans);
    letter-spacing: -0.005em;
    text-decoration: none;
    text-align: center;
    text-wrap: balance;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      --cor-borda var(--dur) var(--ease-saida),
      --cor-fundo var(--dur) var(--ease-saida),
      color var(--dur) var(--ease-saida),
      translate var(--dur-rapida) var(--ease-saida);
  }
  .botao--cheio { display: flex; width: 100%; }

  .botao--primario { --cor-borda: var(--accent); --cor-fundo: var(--accent); color: var(--on-accent); }
  .botao--primario:hover { --cor-borda: var(--accent-hover); --cor-fundo: var(--accent-hover); color: var(--on-accent); }

  .botao--secundario { --cor-borda: var(--line-forte); --cor-fundo: var(--surface); color: var(--ink-strong); }
  .botao--secundario:hover { --cor-borda: var(--accent); color: var(--ink-strong); }

  /*
    Vitrine ("Ver projetos" do hero): o botão de faixa de luz que o Gustavo mandou (pílula azul)
    trazido para a moldura chanfrada. Preenchimento ciano profundo com texto branco (4,9:1; o
    --ink-strong ficaria em 4,49:1), porque a faixa branca some sobre o ciano elétrico. Contorno
    de 3 px = 30% de branco sobre o preenchimento (como a borda translúcida do original), 60% no
    hover. A sombra vai no filter para seguir o chanfro. Inter vai só até 600: sem negrito falso.
  */
  @property --vitrine-faixa { syntax: "<length-percentage>"; inherits: false; initial-value: -100px; }
  .botao--vitrine {
    --espessura: 3px;
    --cor-fundo: var(--ciano-profundo);
    --cor-borda: color-mix(in srgb, #fff 30%, var(--ciano-profundo));
    color: #fff;
    filter: drop-shadow(0 10px 20px rgb(0 0 0 / 0.2));
    transition:
      --cor-borda 0.3s ease-in-out,
      scale 0.3s ease-in-out,
      translate var(--dur-rapida) var(--ease-saida);
  }
  .botao--vitrine:hover { --cor-borda: color-mix(in srgb, #fff 60%, var(--ciano-profundo)); }
  /* Faixa de 100 px a 120°, parada fora do botão; calc(100% + 100px) põe a borda esquerda dela no fim */
  .botao--vitrine::after {
    background:
      linear-gradient(120deg, transparent 30%, rgb(255 255 255 / 0.48), transparent 70%) var(--vitrine-faixa) 0 / 100px 100% no-repeat,
      var(--cor-fundo);
  }
  .botao--vitrine :global(.botao__icone) { transition: translate 0.3s ease-in-out; }
  /* .botao.botao--vitrine: vence a regra geral de 3 px declarada depois */
  .botao.botao--vitrine:hover :global(.botao__icone) { translate: 4px 0; }
  /* Só com mouse de verdade: no toque o hover gruda e a faixa ficaria rodando fora da tela */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .botao--vitrine:hover { scale: 1.05; }
    .botao--vitrine:hover::after { animation: botao-vitrine 1.5s ease-out infinite; }
  }
  @keyframes botao-vitrine {
    0% { --vitrine-faixa: -100px; }
    60%, 100% { --vitrine-faixa: calc(100% + 100px); }
  }

  .botao:active { translate: 0 1px; }
  .botao:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  :global(.botao__icone) { transition: translate var(--dur) var(--ease-saida); }
  .botao:hover :global(.botao__icone) { translate: 3px 0; }

  /* Carregando: o texto fica, o ícone vira um quadrado girando */
  .botao[aria-busy="true"] { cursor: progress; }
  .botao__giro {
    width: 14px;
    height: 14px;
    margin-inline: 3px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    animation: girar 0.9s linear infinite;
  }
  @keyframes girar { to { rotate: 1turn; } }

  /* Desativado */
  .botao:disabled,
  .botao[aria-disabled="true"] {
    --cor-borda: var(--line);
    --cor-fundo: var(--surface-raised);
    color: var(--ink-muted);
    cursor: not-allowed;
    translate: none;
    scale: none;
  }
  .botao:disabled :global(.botao__icone),
  .botao[aria-disabled="true"] :global(.botao__icone) { translate: none; }

  /*
    Brilho de CTA: Shiny Button (21st.dev, designali-in, MIT) recriado em CSS, dentro da moldura
    chanfrada. Duas camadas: na borda (::before), uma luz que corre o contorno com um gradiente
    cônico; no preenchimento (::after), uma faixa de luz que atravessa o botão e, no hover, uma
    trama de pontos. Ao aparecer na tela (scripts/brilho.ts) dá 2 voltas em 4,8 s e para: nada
    se mexe sozinho por mais de 5 s. Com o mouse em cima, ou com o foco do teclado, gira sem
    parar e mais rápido. Com movimento reduzido, fica só a troca de cor de antes.
  */
  @property --brilho-angulo { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
  @property --brilho-luz { syntax: "<color>"; inherits: false; initial-value: transparent; }
  @property --brilho-faixa { syntax: "<percentage>"; inherits: false; initial-value: 130%; }
  @property --brilho-pontos { syntax: "<color>"; inherits: false; initial-value: transparent; }

  .botao--brilho { --espessura: 1.5px; --luz: var(--ink-strong); --faixa: rgb(255 255 255 / 0.38); --pontos: rgb(11 15 20 / 0.09); }
  .botao--brilho.botao--secundario { --luz: var(--accent); --faixa: rgb(53 213 232 / 0.12); --pontos: rgb(53 213 232 / 0.16); }

  @media (prefers-reduced-motion: no-preference) {
    .botao--brilho::before {
      background:
        conic-gradient(from var(--brilho-angulo), transparent 0 62%, var(--brilho-luz) 82%, transparent 92%),
        var(--cor-borda);
    }
    .botao--brilho::after {
      background:
        linear-gradient(105deg, transparent 38%, var(--brilho-luz-faixa, transparent) 50%, transparent 62%) var(--brilho-faixa) 0 / 250% 100% no-repeat,
        radial-gradient(circle at 1px 1px, var(--brilho-pontos) 0.8px, transparent 1.2px) 0 0 / 4px 4px,
        var(--cor-fundo);
      transition: --cor-fundo var(--dur) var(--ease-saida), --brilho-pontos var(--dur) var(--ease-saida);
    }

    /* No secundário, a borda não vira ciano no hover: quem acende é a luz que corre */
    .botao--brilho.botao--secundario:hover { --cor-borda: var(--line-forte); }

    /* Ao aparecer: 2 voltas na borda e a faixa atravessando em cada uma */
    .botao--brilho:global(.is-brilhando)::before { animation: brilho-borda 4.8s linear 1; }
    .botao--brilho:global(.is-brilhando)::after { --brilho-luz-faixa: var(--faixa); animation: brilho-faixa 2.4s ease-in-out 2; }

    /* Mouse em cima ou foco do teclado: sem parar, mais rápido, com os pontos acesos */
    .botao--brilho:hover::before,
    .botao--brilho:focus-visible::before { --brilho-luz: var(--luz); animation: brilho-volta 1.6s linear infinite; }
    .botao--brilho:hover::after,
    .botao--brilho:focus-visible::after {
      --brilho-luz-faixa: var(--faixa);
      --brilho-pontos: var(--pontos);
      animation: brilho-faixa 1.6s ease-in-out infinite;
    }
  }
  @keyframes brilho-borda {
    0% { --brilho-angulo: 0deg; --brilho-luz: transparent; }
    8% { --brilho-luz: var(--luz); }
    88% { --brilho-luz: var(--luz); }
    100% { --brilho-angulo: 720deg; --brilho-luz: transparent; }
  }
  @keyframes brilho-volta {
    to { --brilho-angulo: 360deg; }
  }
  @keyframes brilho-faixa {
    from { --brilho-faixa: 130%; }
    to { --brilho-faixa: -30%; }
  }

  /*
    Sempre (WhatsApp do topo, pedido do Gustavo): a luz da borda gira sem parar, no ritmo da
    entrada (2,4 s por volta; no hover não acelera, porque trocar a duração faz a luz pular).
    No preenchimento, uma aurora: três manchas suaves de ciano profundo, azul-petróleo e um
    toque de ciano elétrico que passeiam em 12 s; sem filter, só radial-gradients com as
    posições em @property. O texto ganha um degradê lento de branco, ciano claro e azul gelo
    (≥ 5:1 mesmo com as três manchas somadas). Com movimento reduzido: luz e aurora paradas,
    texto em cor sólida. O topo nunca sai da tela, então não há pausa por rolagem.
  */
  @property --botao-aurora-x { syntax: "<percentage>"; inherits: false; initial-value: 18%; }
  @property --botao-aurora-y { syntax: "<percentage>"; inherits: false; initial-value: 25%; }
  .botao--sempre.botao--brilho::before {
    --brilho-luz: var(--luz);
    background:
      conic-gradient(from var(--brilho-angulo), transparent 0 62%, var(--brilho-luz) 82%, transparent 92%),
      var(--cor-borda);
  }
  .botao--sempre.botao--brilho::after {
    background:
      linear-gradient(105deg, transparent 38%, var(--brilho-luz-faixa, transparent) 50%, transparent 62%) var(--brilho-faixa) 0 / 250% 100% no-repeat,
      radial-gradient(circle at 1px 1px, var(--brilho-pontos) 0.8px, transparent 1.2px) 0 0 / 4px 4px,
      radial-gradient(70% 130% at var(--botao-aurora-x) var(--botao-aurora-y), rgb(11 124 140 / 0.45), transparent 70%),
      radial-gradient(60% 120% at calc(100% - var(--botao-aurora-x)) calc(100% - var(--botao-aurora-y)), rgb(16 78 110 / 0.5), transparent 70%),
      radial-gradient(45% 90% at var(--botao-aurora-y) var(--botao-aurora-x), rgb(53 213 232 / 0.14), transparent 70%),
      var(--cor-fundo);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Vem depois das regras do brilho: vence a volta única da entrada e a volta rápida do hover */
    .botao--sempre.botao--brilho::before { animation: brilho-volta 2.4s linear infinite; }
    .botao--sempre.botao--brilho::after { animation: botao-aurora 12s ease-in-out infinite; }
    .botao--sempre.botao--brilho:hover::after,
    .botao--sempre.botao--brilho:focus-visible::after { animation: botao-aurora 12s ease-in-out infinite, brilho-faixa 1.6s ease-in-out infinite; }

    @supports (background-clip: text) or (-webkit-background-clip: text) {
      .botao--sempre .botao__texto {
        background: linear-gradient(90deg, var(--ink-strong), #A6EEF6 25%, var(--ink-strong) 50%, #CFE3F7 75%, var(--ink-strong)) 0 0 / 200% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: botao-degrade 10s linear infinite;
      }
    }
  }
  @keyframes botao-aurora {
    0%, 100% { --botao-aurora-x: 18%; --botao-aurora-y: 25%; }
    25% { --botao-aurora-x: 62%; --botao-aurora-y: 90%; }
    50% { --botao-aurora-x: 92%; --botao-aurora-y: 40%; }
    75% { --botao-aurora-x: 40%; --botao-aurora-y: 5%; }
  }
  /* 200% de posição = uma imagem inteira (o dobro do texto): a volta fecha sem emenda */
  @keyframes botao-degrade {
    to { background-position: 200% 0; }
  }

  /*
    Navegação (secundários sem brilho): em repouso, a borda fica aberta nos dois cantos chanfrados;
    com o mouse em cima ou o foco do teclado, ela se fecha e acende em ciano, como um circuito que
    completa. Variação do botão de cantos abertos de adamgiebl (Uiverse, MIT), recriada em CSS na
    moldura chanfrada: uma máscara corta dois quadrados da camada de borda (::before) e encolhe.
  */
  @property --abre { syntax: "<length>"; inherits: false; initial-value: 0px; }
  .botao--navega::before {
    --abre: 22px;
    -webkit-mask:
      linear-gradient(#000 0 0) top left / var(--abre) var(--abre) no-repeat,
      linear-gradient(#000 0 0) bottom right / var(--abre) var(--abre) no-repeat,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor, xor;
    mask:
      linear-gradient(#000 0 0) top left / var(--abre) var(--abre) no-repeat exclude,
      linear-gradient(#000 0 0) bottom right / var(--abre) var(--abre) no-repeat exclude,
      linear-gradient(#000 0 0);
    transition: --abre var(--dur-lenta) var(--ease-saida);
  }
  .botao--navega:hover::before,
  .botao--navega:focus-visible::before { --abre: 0px; }
  @media (prefers-reduced-motion: reduce) {
    .botao--navega::before { transition: none; }
  }

  /* Alto contraste do Windows: a moldura chanfrada some com os fundos; a borda real fica no lugar */
  @media (forced-colors: active) {
    .botao { border: 1px solid ButtonText; }
    .botao--sempre .botao__texto { background: none; color: ButtonText; }
  }
</style>
