---
/*
  Vídeo de abertura (videos-braga, Remotion; 5 s tocados a 1,5× = ~3,3 s; desktop 1920×1080 e celular 1080×1920).
  Toca por cima do site já carregado, só na primeira visita, e se desfaz revelando o hero.
  Não toca: em visitas seguintes, com movimento reduzido, com economia de dados, quando o
  endereço abre numa âncora (/#planos) ou se o vídeo não começar em 3 s (nesse caso tenta de
  novo na próxima visita: "já viu" só conta se tocou ou se a pessoa pulou). Quando não toca, nada
  é baixado: o vídeo só ganha src pelo script, depois da decisão (um arquivo só: WebM onde o
  navegador garante VP9, MP4 no resto, como o Safari do iPhone). Para testar: /?abertura força.
  Enquanto ele toca, as entradas do hero ficam pausadas (html[data-abertura]) e começam quando
  ele sai, para o visitante ver o site "ligar" depois do logo.
  O botão "Pular abertura" e Esc encerram na hora. Sem JavaScript: nada aparece.
*/
---
<div class="abertura-video" hidden data-abertura>
  <video class="abertura-video__video" muted playsinline preload="none" aria-hidden="true" data-abertura-video></video>
  <button class="abertura-video__pular" type="button" data-abertura-pular>Pular abertura</button>
</div>

<script is:inline>
  // Roda antes da primeira pintura: decide se a abertura aparece, sem piscar o site por baixo
  (() => {
    const caixa = document.querySelector("[data-abertura]");
    const video = caixa && caixa.querySelector("[data-abertura-video]");
    if (!video) return;
    // ?abertura força a abertura (testar no celular sem limpar o navegador). ?abertura=diag força
    // também com movimento reduzido e economia de dados, e mostra na tela o que aconteceu.
    const busca = location.search;
    const forcar = /[?&]abertura(=|&|$)/.test(busca);
    const diag = /[?&]abertura=diag/.test(busca);
    const log = [];
    const nota = (t) => log.push(Math.round(performance.now()) + "ms " + t);
    let visto = false;
    try { visto = !forcar && localStorage.getItem("braga-abertura") === "1"; } catch {}
    const reduzido = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const economia = !!(navigator.connection && navigator.connection.saveData);
    nota("visto=" + visto + " reduzido=" + reduzido + " economia=" + economia + " ancora=" + !!location.hash);
    if (!diag && (visto || reduzido || economia || location.hash)) return;

    const raiz = document.documentElement;
    const celular = matchMedia("(max-aspect-ratio: 1/1)").matches;
    const nome = celular ? "abertura-mobile" : "abertura-desktop";
    // Um arquivo só, o que este navegador garante tocar: o Safari do iPhone diz "maybe" para WebM
    // VP9 e falha; com dois <source>, a falha do primeiro encerrava a abertura antes do MP4
    const webm = video.canPlayType('video/webm; codecs="vp9"') === "probably";
    video.src = "/videos/abertura/" + nome + (webm ? ".webm" : ".mp4");
    nota("arquivo=" + video.src.split("/").pop() + " rede=" + ((navigator.connection && navigator.connection.effectiveType) || "?"));
    caixa.hidden = false;
    raiz.dataset.abertura = "tocando";

    let fim = false;
    let tocou = false;
    // "Já viu" só conta se o vídeo chegou a tocar (ou se a pessoa pulou): se ele falhou ou
    // demorou a começar, a abertura tenta de novo na próxima visita
    const terminar = (viu, motivo) => {
      if (fim) return;
      fim = true;
      nota("fim: " + (motivo || "?"));
      if (viu === true || tocou) try { localStorage.setItem("braga-abertura", "1"); } catch {}
      caixa.classList.add("is-saindo");
      delete raiz.dataset.abertura;
      document.dispatchEvent(new Event("abertura:fim"));
      setTimeout(() => caixa.remove(), 700);
      if (diag) {
        const p = document.createElement("pre");
        p.textContent = log.join("\n");
        p.style.cssText = "position:fixed;left:8px;right:8px;bottom:8px;z-index:300;margin:0;padding:10px;font:11px/1.4 monospace;white-space:pre-wrap;color:#D6DDE6;background:#202833;border:1px solid #35D5E8";
        setTimeout(() => document.body.append(p), 800);
      }
    };
    video.addEventListener("ended", () => terminar(false, "terminou"));
    video.addEventListener("error", () => terminar(false, "erro do vídeo " + (video.error && video.error.code)));
    caixa.querySelector("[data-abertura-pular]").addEventListener("click", () => terminar(true, "pulou"));
    addEventListener("keydown", (e) => { if (e.key === "Escape") terminar(true, "Esc"); });
    // Se não começar a tocar logo (rede lenta, aparelho ocupado, autoplay bloqueado), o site não fica esperando
    const guarda = setTimeout(() => terminar(false, "não começou em 3 s"), 3000);
    video.addEventListener("playing", () => { tocou = true; nota("tocando"); clearTimeout(guarda); setTimeout(() => terminar(false, "teto de tempo"), 4500); }, { once: true });
    // 1,5× (pedido do Gustavo, 26/10/2026): os 5 s do vídeo viram ~3,3 s
    video.defaultPlaybackRate = video.playbackRate = 1.5;
    video.play().catch((e) => terminar(false, "play recusado: " + (e && e.name)));
  })();
</script>

<style>
  .abertura-video {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: #0B0F14;
    transition: opacity 600ms var(--ease-saida);
  }
  .abertura-video[hidden] { display: none; }
  .abertura-video.is-saindo { opacity: 0; pointer-events: none; }
  .abertura-video__video {
    width: 100%;
    height: 100%;
    /* Inteiro, sem cortar os rótulos dos cantos: as sobras têm a mesma cor do fundo do vídeo */
    object-fit: contain;
  }
  .abertura-video__pular {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: calc(var(--gutter) + env(safe-area-inset-bottom));
    min-height: 44px;
    padding: 0 var(--s-4);
    font: 500 var(--t-label, 0.75rem)/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: transparent;
    border: 1px solid var(--line);
    cursor: pointer;
    transition: color 200ms, border-color 200ms;
  }
  .abertura-video__pular:hover,
  .abertura-video__pular:focus-visible { color: var(--ink-strong); border-color: var(--accent); }
  .abertura-video__pular:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* Enquanto a abertura toca, as entradas do site esperam */
  :global(html[data-abertura] body *) { animation-play-state: paused !important; }
</style>
