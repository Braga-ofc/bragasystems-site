---
/*
  Selo de vagas (copy §2) e selo RECOMENDADO (copy §9). Os textos vêm do content:
  hero.selo (com vagas, com 1 vaga, esgotado, falha) e performance.selo.
  O estado das vagas é aplicado pelo script do contador trocando o <html data-vagas-estado> e o
  número; todas as variantes já vêm no HTML para a página não "pular".
  Com estado="auto" (a home), quem decide é o contador: a forma de 1 vaga ("resta 1") usa
  data-quando-n. Com estado fixo (a /amostra), sai só o texto daquele estado e daquele número.
  Movimento (pedido do Gustavo: pequeno, mas tem que chamar atenção), só no selo de vagas:
  - 0–400 ms: a moldura varre da esquerda (clip-path) e o texto acende logo atrás, saindo do desfoque.
  - Depois, sem parar: uma luz ciano corre o contorno (em cima →, embaixo ←, virando nas pontas),
    com um halo desfocado que a acompanha; o "25% off" pisca em vermelho (1 vez a cada 1,2 s).
    Fora da tela os loops pausam; esgotado não tem luz; movimento reduzido mostra tudo parado.
*/
import { hero } from "../../content/home";
import { performance } from "../../content/planos";
import { comVagas, rich } from "../../lib/texto";

interface Props {
  tipo?: "vagas" | "recomendado";
  estado?: "com-vagas" | "esgotado" | "falha" | "auto";
  vagas?: number;
  class?: string;
}
const { tipo = "vagas", estado = "com-vagas", vagas = 5, class: classe } = Astro.props;

const auto = estado === "auto";
// Marca o trecho "25% off" da copy para piscar em vermelho. Se a copy mudar, o texto sai igual, só sem o destaque.
const desconto = (html: string) => html.replace("25% off", '<span class="selo__desconto">$&</span>');
const comNumero = desconto(comVagas(rich(hero.selo.comVagas), vagas));
const comUma = desconto(rich(hero.selo.comUmaVaga));
---
{tipo === "recomendado" ? (
  <span class:list={["selo", "selo--recomendado", "chanfrado", classe]}>{performance.selo}</span>
) : (
  <span class:list={["selo", "selo--vagas", "chanfrado", classe]} data-selo-vagas data-estado={auto ? undefined : estado}>
    <span class="selo__brilho" aria-hidden="true"></span>
    <span class="selo__marca" aria-hidden="true"></span>
    {auto ? (
      <>
        <span class="selo__texto" data-quando="com-vagas" data-quando-n="plural" set:html={comNumero} />
        <span class="selo__texto" data-quando="com-vagas" data-quando-n="singular" set:html={comUma} />
      </>
    ) : (
      <span class="selo__texto" data-quando="com-vagas" set:html={vagas === 1 ? comUma : comNumero} />
    )}
    <span class="selo__texto" data-quando="esgotado">{hero.selo.esgotado}</span>
    <span class="selo__texto" data-quando="falha">{hero.selo.falha}</span>
  </span>
)}

<script>
  // Loop infinito fora da vista só gasta bateria: pausa o brilho e o piscar quando o selo sai da tela.
  const selos = document.querySelectorAll<HTMLElement>("[data-selo-vagas]");
  if (selos.length && "IntersectionObserver" in window) {
    const observador = new IntersectionObserver((entradas) => {
      for (const entrada of entradas) entrada.target.classList.toggle("selo--fora", !entrada.isIntersecting);
    });
    selos.forEach((selo) => observador.observe(selo));
  }
</script>

<style>
  .selo {
    --c: 7px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    padding: 6px 14px 6px 12px;
    font: 500 clamp(0.6875rem, 0.64rem + 0.2vw, 0.75rem)/1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .selo--vagas { --cor-borda: var(--line-forte); --cor-fundo: var(--surface); color: var(--ink); }
  .selo--vagas :global([data-vagas]) { color: var(--ink-strong); }

  /* A cunha: o "núcleo" do símbolo, em 45°. Ciano só quando há vagas contadas. */
  .selo__marca {
    width: 12px;
    height: 8px;
    flex: none;
    background: var(--accent);
    clip-path: polygon(0 0, 50% 0, 100% 100%, 50% 100%);
    transition: background-color var(--dur) var(--ease-saida);
  }

  .selo__texto { display: none; }
  [data-estado="com-vagas"] > [data-quando="com-vagas"],
  [data-estado="esgotado"] > [data-quando="esgotado"],
  [data-estado="falha"] > [data-quando="falha"] { display: inline; }
  [data-estado="esgotado"] .selo__marca,
  [data-estado="falha"] .selo__marca { background: var(--ink-muted); }

  /* Modo automático: segue o estado do contador na página (carregando = sem leitura, como a falha) */
  :global(:root[data-vagas-estado="com-vagas"]) .selo--vagas:not([data-estado]) > [data-quando="com-vagas"],
  :global(:root[data-vagas-estado="esgotado"]) .selo--vagas:not([data-estado]) > [data-quando="esgotado"],
  :global(:root[data-vagas-estado="falha"]) .selo--vagas:not([data-estado]) > [data-quando="falha"],
  :global(:root[data-vagas-estado="carregando"]) .selo--vagas:not([data-estado]) > [data-quando="falha"] { display: inline; }
  :global(:root[data-vagas-estado="esgotado"]) .selo--vagas:not([data-estado]) .selo__marca,
  :global(:root[data-vagas-estado="falha"]) .selo--vagas:not([data-estado]) .selo__marca,
  :global(:root[data-vagas-estado="carregando"]) .selo--vagas:not([data-estado]) .selo__marca { background: var(--ink-muted); }

  /* "25% off" em vermelho vivo: #FF5A5F dá ~6,3:1 sobre o fundo do selo (#0B0F14) */
  .selo :global(.selo__desconto) {
    color: #FF5A5F;
    text-shadow: 0 0 8px rgb(255 90 95 / 0.55);
  }

  /* Halo da luz do contorno: atrás da moldura (que é opaca), então só aparece do lado de fora */
  .selo__brilho {
    position: absolute;
    inset: -3px;
    z-index: -2;
    pointer-events: none;
  }

  /*
    Luz que corre o contorno: o mesmo papel do .feixe (Border Beam do Magic UI, MIT), mas com duas
    faixas lineares em vez de um conic-gradient. Num selo ~11× mais largo que alto, o conic se arrasta
    no meio e dispara nas pontas; as faixas andam em velocidade constante e "viram" em cada ponta.
    A de cima vai da esquerda para a direita; quando a cabeça dela chega na ponta, a de baixo entra
    voltando. Posições (faixa de 32% x 50%): cabeça na borda em -40%→107% (cima) e 140%→-7% (baixo);
    -50% e 150% = fora do selo, onde o loop recomeça sem salto visível.
  */
  @property --selo-x1 { syntax: "<percentage>"; inherits: false; initial-value: -50%; }
  @property --selo-x2 { syntax: "<percentage>"; inherits: false; initial-value: -50%; }

  @media (prefers-reduced-motion: no-preference) {
    .selo--vagas { animation: selo-entra var(--dur-lenta) var(--ease-saida) backwards; }
    /* A luz anima só nas duas camadas que a desenham: na raiz, a variável herdada recalculava o selo inteiro a cada quadro */
    .selo--vagas::before,
    .selo--vagas .selo__brilho {
      --selo-luz:
        linear-gradient(90deg, transparent, var(--ciano-eletrico-forte) 85%, transparent) var(--selo-x1) 0 / 32% 50% no-repeat,
        linear-gradient(270deg, transparent, var(--ciano-eletrico-forte) 85%, transparent) var(--selo-x2) 100% / 32% 50% no-repeat;
      animation:
        selo-ida 2.8s linear var(--dur-lenta) infinite,
        selo-volta 2.8s linear calc(var(--dur-lenta) + 1.4s) infinite;
    }
    .selo--vagas::before { background: var(--selo-luz), var(--cor-borda); }
    .selo__brilho { background: var(--selo-luz); filter: blur(5px); }
    .selo--vagas .selo__marca,
    .selo--vagas .selo__texto { animation: selo-texto var(--dur) var(--ease-saida) 160ms backwards; }
    .selo :global(.selo__desconto) { animation: selo-pisca 1.2s ease-in-out infinite; }

    /* Esgotado: só a entrada; luz correndo ali anunciaria uma vaga que não existe */
    .selo--vagas[data-estado="esgotado"]::before,
    .selo--vagas[data-estado="esgotado"] .selo__brilho,
    :global(:root[data-vagas-estado="esgotado"]) .selo--vagas:not([data-estado])::before,
    :global(:root[data-vagas-estado="esgotado"]) .selo--vagas:not([data-estado]) .selo__brilho { animation: none; }

    .selo--fora,
    .selo--fora::before,
    .selo--fora .selo__brilho,
    .selo--fora :global(.selo__desconto) { animation-play-state: paused; }
  }

  /* Insets negativos: o halo não é cortado durante a varredura. Sem "forwards", o clip-path some no fim. */
  @keyframes selo-entra {
    from { clip-path: inset(-8px 100% -8px -8px); }
    to { clip-path: inset(-8px); }
  }
  @keyframes selo-texto {
    from { opacity: 0; filter: blur(3px); }
  }
  @keyframes selo-ida {
    0% { --selo-x1: -40%; }
    50% { --selo-x1: 107%; }
    65%, 100% { --selo-x1: 150%; }
  }
  @keyframes selo-volta {
    0% { --selo-x2: 140%; }
    50% { --selo-x2: -7%; }
    65%, 100% { --selo-x2: -50%; }
  }
  /*
    Menos de 1 piscada por segundo (WCAG 2.3.1 permite até 3). Pisca trocando de cor, vermelho ↔ prata:
    as duas passam de 4,5:1 no fundo do selo (a opacidade derrubava para 2:1). O brilho muda só de cor,
    nunca de tamanho: mudar o raio refazia o layout da página a cada quadro.
  */
  @keyframes selo-pisca {
    0%, 40%, 100% { color: #FF5A5F; text-shadow: 0 0 8px rgb(255 90 95 / 0.55); }
    55%, 85% { color: var(--ink); text-shadow: 0 0 8px rgb(255 90 95 / 0); }
  }

  /* Alto contraste: o sistema pinta o texto; sem halo e sem nada piscando */
  @media (forced-colors: active) {
    .selo__brilho { display: none; }
    .selo--vagas,
    .selo--vagas::before,
    .selo :global(.selo__desconto) { animation: none; }
  }

  .selo--recomendado {
    --c: 6px;
    --cor-borda: var(--accent);
    --cor-fundo: var(--accent);
    min-height: 26px;
    padding: 4px 12px;
    color: var(--on-accent);
    letter-spacing: 0.16em;
  }
</style>
