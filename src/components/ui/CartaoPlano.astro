---
/*
  Cartão de plano (copy §9; mapa técnico, arquivo 06): normal e destaque (Performance).
  Preço pelo contador de vagas (mapa técnico, arquivo 03): com vagas ou falha, o cheio riscado e o
  de fundador; esgotado, só o cheio. As duas variantes já vêm no HTML (data-quando-vagas); fora de
  uma página com o contador, as duas apareceriam juntas.
  O Performance é o único destaque ciano da seção: fundo grafite, borda ciano, brilho, selo,
  botão preenchido e o feixe que dá 1 volta na borda ao entrar na tela e para.
  O brilho é uma camada parada atrás do cartão (.plano__brilho), e não um filtro no cartão:
  assim o feixe, que se redesenha a cada quadro, não obriga o navegador a refazer o desfoque.
*/
import Botao from "./Botao.astro";
import Icone from "./Icone.astro";
import Selo from "./Selo.astro";
import { performance, secaoPlanos, type Plano } from "../../content/planos";
import { montarLinkWhatsapp } from "../../lib/whatsapp";

interface Props {
  plano: Plano;
  class?: string;
}
const { plano, class: classe } = Astro.props;
const destaque = plano.destaque === true;
const idNome = `plano-${plano.id}-nome`;

// Copy §9: o Signature tem "A partir de" antes do preço.
const aPartirDe = secaoPlanos.aPartirDe;

// "R$ 699" → moeda e número, para o número ganhar o tamanho da leitura. O texto não muda.
function separar(preco: string) {
  const i = preco.indexOf(" ");
  return i > 0 ? { moeda: preco.slice(0, i), valor: preco.slice(i + 1) } : { moeda: "", valor: preco };
}
const cheio = separar(plano.precoCheio);
const fundador = separar(plano.precoFundador);

// "R$ 1.197 no preço de fundador" → o valor em destaque e o resto como legenda.
const pagaMatch = performance.vocePagaFundador.match(/^(R\$\s?[\d.,]+)(.*)$/);
const pagaFundador = pagaMatch
  ? { valor: pagaMatch[1], legenda: pagaMatch[2] }
  : { valor: performance.vocePagaFundador, legenda: "" };

// "Também inclui: ..." → o começo vira rótulo.
const fimRotulo = performance.tambem.indexOf(":") + 1;
const tambem = { rotulo: performance.tambem.slice(0, fimRotulo), texto: performance.tambem.slice(fimRotulo) };
---
<article
  class:list={["plano", "chanfrado", destaque ? "plano--destaque feixe" : "plano--padrao", classe]}
  aria-labelledby={idNome}
  data-plano={plano.id}
  data-feixe={destaque ? "" : undefined}
>
  {destaque && <span class="plano__brilho" aria-hidden="true"><span class="plano__brilho-luz"></span></span>}
  {destaque && <Selo tipo="recomendado" class="plano__selo" />}

  <div class="plano__corpo">
    <div class="plano__oferta">
      <h3 id={idNome} class="plano__nome">{plano.nome}</h3>

      <div class="plano__preco">
        <p class="plano__valor" data-quando-vagas="com falha">
          {plano.aPartirDe && <span class="plano__apartir">{aPartirDe}</span>}
          <s class="plano__cheio num">{plano.precoCheio}</s>
          <strong class="plano__numero num"><span class="plano__moeda">{fundador.moeda}</span> {fundador.valor}</strong>
          <span class="plano__legenda">{secaoPlanos.precoFundadorRotulo}</span>
        </p>
        <p class="plano__valor" data-quando-vagas="esgotado">
          {plano.aPartirDe && <span class="plano__apartir">{aPartirDe}</span>}
          <strong class="plano__numero num"><span class="plano__moeda">{cheio.moeda}</span> {cheio.valor}</strong>
        </p>
      </div>

      <p class="plano__para">{plano.para}</p>
    </div>

    {destaque ? (
      <div class="plano__recebe">
        <p class="plano__recebe-titulo">{performance.recebeTitulo}</p>
        <ul class="plano__lista" role="list">
          {performance.itens.map((item) => (
            <li class="plano__item plano__item--valor">
              <Icone nome="check" tamanho={18} class="plano__check" />
              <span class="plano__item-texto">{item.texto}</span>
              <span class="plano__item-valor num">{item.valor}</span>
            </li>
          ))}
        </ul>

        <dl class="plano__conta">
          <div class="plano__conta-linha">
            <dt>{performance.valorTotalRotulo}</dt>
            <dd><s class="plano__total num">{performance.valorTotal}</s></dd>
          </div>
          <div class="plano__conta-linha plano__conta-linha--paga">
            <dt>{performance.vocePagaRotulo}</dt>
            <dd>
              <span data-quando-vagas="com falha"><strong class="num">{pagaFundador.valor}</strong>{pagaFundador.legenda}</span>
              <span data-quando-vagas="esgotado"><strong class="num">{performance.vocePagaCheio}</strong></span>
            </dd>
          </div>
        </dl>

        <p class="plano__tambem"><span class="plano__tambem-rotulo">{tambem.rotulo}</span>{tambem.texto}</p>
      </div>
    ) : (
      <ul class="plano__lista plano__lista--itens" role="list">
        {plano.itens.map((item) => (
          <li class="plano__item">
            <Icone nome="check" tamanho={18} class="plano__check" />
            <span class="plano__item-texto">{item}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="plano__fim">
      <p class="plano__prazo num">{plano.prazo}</p>
      <Botao
        variante={destaque ? "primario" : "secundario"}
        href={montarLinkWhatsapp(plano.origem)}
        origem={plano.origem}
        icone={destaque ? "whatsapp" : null}
        larguraTotal
      >{plano.botao}</Botao>
    </div>
  </div>
</article>

<script>
  /*
    Feixe na borda do Performance ao entrar na tela: 1 volta e para
    (Border Beam do Magic UI, MIT, recriado em CSS no global.css). Sem movimento reduzido, nada liga.
  */
  const semMovimento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cartoes = document.querySelectorAll<HTMLElement>("[data-feixe]");

  if (!semMovimento && cartoes.length && "IntersectionObserver" in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          entrada.target.classList.add("feixe--ativo");
          observador.unobserve(entrada.target);
        }
      },
      { threshold: 0.35 },
    );
    cartoes.forEach((cartao) => observador.observe(cartao));
  }
</script>

<style>
  .plano {
    --c: var(--chanfro-lg);
    --pad: var(--s-5);
    container: plano / inline-size;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--pad);
    color: var(--ink);
  }
  .plano--padrao { --cor-borda: var(--line); --cor-fundo: var(--surface); }
  /* O módulo acende a borda junto com o botão dele */
  .plano--padrao:has(.botao:hover),
  .plano--padrao:focus-within { --cor-borda: var(--line-forte); }

  .plano--destaque {
    --cor-borda: var(--accent);
    --cor-fundo: var(--surface-raised);
    padding-top: calc(var(--pad) + var(--s-3));
  }

  /*
    Brilho do Performance: o recorte chanfrado em --brilho, desfocado e um pouco abaixo, atrás das
    camadas de borda e fundo. Três níveis, cada um com um papel:
    - .plano__brilho: camada própria e parada (will-change), que o feixe animado não invalida;
    - .plano__brilho-luz: o desfoque, pintado uma vez dentro dessa camada (e não refeito a cada quadro);
    - ::before: o recorte chanfrado na cor do brilho.
  */
  .plano__brilho {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    will-change: transform;
  }
  .plano__brilho-luz {
    position: absolute;
    inset: 0;
    translate: 0 16px;
    filter: blur(40px); /* mesmo desfoque do drop-shadow(0 16px 40px) de antes, medido em pixel */
  }
  .plano__brilho-luz::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--brilho);
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
  }
  @media (forced-colors: active) {
    .plano__brilho { display: none; }
  }

  /* Selo RECOMENDADO preso na borda de cima, como a etiqueta do módulo */
  .plano :global(.plano__selo) {
    position: absolute;
    top: 0;
    left: calc(var(--pad) + var(--s-2));
    translate: 0 -50%;
    z-index: 1;
  }

  .plano__corpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .plano__oferta { display: grid; gap: var(--s-4); align-content: start; }

  .plano__nome {
    font: 500 var(--t-label)/1.3 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .plano--destaque .plano__nome { color: var(--ink); }

  /* Preço como leitura: riscado em mono, o número grande, a legenda em rótulo */
  .plano__valor {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-2);
  }
  .plano__apartir { font-size: var(--t-small); color: var(--ink-muted); }
  .plano__cheio {
    font: 400 var(--t-small)/1.4 var(--font-mono);
    color: var(--ink-muted);
    text-decoration-thickness: 1px;
  }
  .plano__numero {
    flex-basis: 100%;
    font: 600 var(--t-h1)/1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--ink-strong);
    white-space: nowrap;
  }
  .plano--destaque .plano__numero { font-size: calc(var(--t-h1) * 1.25); }
  .plano__moeda {
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
  }
  .plano__legenda {
    flex-basis: 100%;
    margin-top: var(--s-1);
    font: 500 var(--t-label)/1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .plano__para { max-width: 34ch; color: var(--ink); }

  /* Listas: check fino, linhas apertadas, separadas do preço por uma divisória */
  .plano__lista {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
    line-height: 1.5;
  }
  .plano__lista--itens { padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .plano__item {
    position: relative;
    padding-left: calc(18px + var(--s-3));
    color: var(--ink);
  }
  .plano :global(.plano__check) {
    position: absolute;
    top: 1px;
    left: 0;
    color: var(--ink-muted);
  }

  /* Performance: a lista com o valor de mercado à direita, como uma nota de serviço */
  .plano__recebe {
    display: grid;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-forte);
  }
  .plano__recebe-titulo { font-size: var(--t-small); font-weight: 600; color: var(--ink-strong); }
  .plano__item--valor {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px var(--s-3);
  }
  .plano__item-texto { flex: 1 1 11rem; min-width: 0; }
  .plano__item-valor {
    flex: none;
    margin-left: auto;
    font: 400 var(--t-label)/1.5 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .plano__conta { margin: 0; border-top: 1px solid var(--line-forte); }
  .plano__conta-linha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-1) var(--s-3);
    padding-block: var(--s-3);
  }
  .plano__conta-linha + .plano__conta-linha { border-top: 1px solid var(--line); }
  .plano__conta-linha dt { font-size: var(--t-small); font-weight: 600; color: var(--ink-strong); }
  .plano__conta-linha dd {
    margin: 0;
    margin-left: auto;
    text-align: right;
    font-size: var(--t-small);
    color: var(--ink-muted);
  }
  .plano__total {
    font: 400 var(--t-small)/1.4 var(--font-mono);
    text-decoration-thickness: 1px;
  }
  .plano__conta-linha--paga strong {
    margin-right: 0.3em;
    font: 600 var(--t-h3)/1.2 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink-strong);
  }

  .plano__tambem { font-size: var(--t-small); line-height: 1.55; color: var(--ink-muted); }
  .plano__tambem-rotulo { font-weight: 600; color: var(--ink); }

  /* Fim do cartão: o prazo como leitura e o botão, sempre alinhados embaixo */
  .plano__fim {
    display: grid;
    gap: var(--s-4);
    margin-top: auto;
    padding-top: var(--s-2);
  }
  .plano__prazo {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font: 500 var(--t-label)/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .plano__prazo::before {
    content: "";
    width: 12px;
    height: 8px;
    flex: none;
    background: var(--line-forte);
    clip-path: polygon(0 0, 50% 0, 100% 100%, 50% 100%);
  }

  @media (min-width: 720px) {
    .plano { --pad: var(--s-6); }
  }

  /* Cartão largo (o Performance na linha inteira do tablet): a oferta e o botão à esquerda, a lista à direita */
  @container plano (min-width: 600px) {
    .plano__corpo {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-areas: "oferta lista" "fim lista";
      grid-template-rows: auto 1fr;
      gap: var(--s-5) var(--s-7);
    }
    .plano__oferta { grid-area: oferta; }
    .plano__recebe,
    .plano__lista--itens { grid-area: lista; align-self: start; padding-top: 0; border-top: 0; }
    .plano__fim { grid-area: fim; align-self: end; }
  }
</style>
