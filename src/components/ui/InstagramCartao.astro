---
/*
  Instagram da BRAGA SYSTEMS no rodapé (pedido do Gustavo, 29/10/2026), a partir do código que ele mandou:
  o ícone em camadas que se abrem em leque no hover e, por cima, um cartão de perfil com o nome, o @ e
  uma linha sobre a empresa. O degradê do ícone é o do Instagram; o resto segue a marca (chanfro em
  45°, nome em ciano e o B no lugar das iniciais). Com teclado, o foco abre o mesmo cartão; no toque,
  o link leva direto ao perfil.
*/
import { site } from "../../config/site";
import { pecasDoB } from "../../lib/marca";

const sobre = "Sites e landing pages de alta conversão.";
---
<div class="ig">
  <div class="ig__cartao" aria-hidden="true">
    <div class="ig__perfil">
      <div class="ig__usuario">
        <span class="ig__foto">
          <svg viewBox="0 0 256 256">
            <path d={pecasDoB.haste + pecasDoB.corpo} fill={pecasDoB.corPeca} fill-rule="evenodd" />
            <path d={pecasDoB.nucleo} fill={pecasDoB.corLuz} />
          </svg>
        </span>
        <span class="ig__dados">
          <span class="ig__nome">BRAGA SYSTEMS</span>
          <span class="ig__arroba">{site.instagram.usuario}</span>
        </span>
      </div>
      <p class="ig__sobre">{sobre}</p>
    </div>
  </div>

  <a class="ig__icone" href={site.instagram.url} target="_blank" rel="noopener" aria-label={`Instagram da BRAGA SYSTEMS: ${site.instagram.usuario}`}>
    <span class="ig__camadas" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span class="ig__svg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
        </svg>
      </span>
    </span>
    <span class="ig__texto" aria-hidden="true">Instagram</span>
  </a>
</div>

<style>
  .ig { --ig: #E6683C; position: relative; width: max-content; font-size: 17px; }

  /* O cartão de perfil: escondido acima do ícone; sobe e aparece no hover ou no foco */
  .ig__cartao {
    --c: 12px;
    position: absolute;
    z-index: 5;
    bottom: 0;
    left: 0;
    padding: 10px;
    opacity: 0;
    pointer-events: none;
    transition: bottom 300ms var(--ease-saida), opacity 300ms var(--ease-saida);
    background: #0E1319;
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
    box-shadow: inset 5px 5px 5px rgb(0 0 0 / 0.2), inset -5px -5px 15px rgb(255 255 255 / 0.06);
  }
  .ig:hover .ig__cartao,
  .ig:focus-within .ig__cartao { bottom: calc(100% + 16px); opacity: 1; pointer-events: auto; }
  .ig__perfil {
    --c: 8px;
    min-width: 230px;
    padding: 10px;
    background: #1A2129;
    border: 1px solid var(--line);
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
  }
  .ig__usuario { display: flex; gap: 10px; align-items: center; }
  .ig__foto {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    background: #0B0F14;
    border: 1px solid var(--ig);
  }
  .ig__foto svg { width: 30px; height: 30px; }
  .ig__dados { display: flex; flex-direction: column; color: var(--ink-strong); font-size: 15px; }
  .ig__nome { font: 700 17px/1.2 var(--font-display); color: var(--accent); }
  .ig__sobre { margin: 0; padding-top: 6px; font-size: 14px; color: var(--ink-muted); }

  /* O ícone em camadas: no hover elas se abrem em leque, cada uma mais apagada */
  .ig__icone { position: relative; display: block; color: var(--ig); text-decoration: none; }
  .ig__camadas { position: relative; display: block; width: 55px; height: 55px; transition: transform 300ms var(--ease-saida); }
  .ig__camadas span {
    --c: 12px;
    position: absolute;
    inset: 0;
    border: 1px solid var(--ig);
    clip-path: polygon(var(--c) 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 var(--c));
    transition: transform 300ms var(--ease-saida), opacity 300ms var(--ease-saida);
  }
  /* A camada de cima leva o degradê do Instagram e o desenho do ícone */
  .ig__svg {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    background: linear-gradient(45deg, #F09433 0%, #E6683C 25%, #DC2743 50%, #CC2366 75%, #BC1888 100%);
  }
  .ig__svg svg { width: 26px; height: 26px; }
  .ig__texto {
    position: absolute;
    bottom: -5px;
    left: 50%;
    opacity: 0;
    font-weight: 500;
    font-size: 15px;
    color: var(--ig);
    translate: -50% 0;
    transition: bottom 300ms ease, opacity 300ms ease;
  }

  .ig__icone:hover .ig__camadas,
  .ig__icone:focus-visible .ig__camadas { transform: rotate(-35deg) skew(20deg); }
  .ig__icone:hover .ig__camadas span:nth-child(1), .ig__icone:focus-visible .ig__camadas span:nth-child(1) { opacity: 0.2; }
  .ig__icone:hover .ig__camadas span:nth-child(2), .ig__icone:focus-visible .ig__camadas span:nth-child(2) { opacity: 0.4; transform: translate(5px, -5px); }
  .ig__icone:hover .ig__camadas span:nth-child(3), .ig__icone:focus-visible .ig__camadas span:nth-child(3) { opacity: 0.6; transform: translate(10px, -10px); }
  .ig__icone:hover .ig__camadas span:nth-child(4), .ig__icone:focus-visible .ig__camadas span:nth-child(4) { opacity: 0.8; transform: translate(15px, -15px); }
  .ig__icone:hover .ig__camadas span:nth-child(5), .ig__icone:focus-visible .ig__camadas span:nth-child(5) { opacity: 1; transform: translate(20px, -20px); }
  .ig__icone:hover .ig__texto,
  .ig__icone:focus-visible .ig__texto { bottom: -35px; opacity: 1; }
  .ig__icone:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }

  @media (prefers-reduced-motion: reduce) {
    .ig__cartao, .ig__camadas, .ig__camadas span, .ig__texto { transition: none; }
  }
</style>
