---
// Ícones lineares da marca: traço único, pontas retas, ângulos de 0°, 45° e 90°.
interface Props {
  nome: "whatsapp" | "seta" | "seta-baixo" | "check" | "alerta" | "externo" | "menu" | "fechar" | "mais" | "instagram" | "facebook";
  tamanho?: number;
  class?: string;
}
const { nome, tamanho = 20, class: classe } = Astro.props;
const caminhos: Record<Props["nome"], string> = {
  whatsapp: "M4 4.5h16v11.5H11l-5 4v-4H4z M8 8.75h8 M8 11.75h5",
  seta: "M4.5 12h14 M13 6.5l5.5 5.5-5.5 5.5",
  "seta-baixo": "M6.5 9.5l5.5 5.5 5.5-5.5",
  check: "M5 12.5l4.5 4.5L19 7.5",
  alerta: "M12 3.5l9 16H3z M12 9.5v4.5 M12 16.5v1",
  externo: "M8 6.5h9.5V16 M17.5 6.5L6.5 17.5",
  menu: "M4 8h16 M4 16h16",
  fechar: "M6 6l12 12 M18 6L6 18",
  mais: "M12 5v14 M5 12h14",
  instagram: "M7.5 3.5h9l4 4v9l-4 4h-9l-4-4v-9z M12 8.5a3.5 3.5 0 1 0 0.01 0z M16.75 6.75v0.5",
  facebook: "M14.5 3.5h3v3.5h-2.5v3h2.5v3.5h-2.5v7h-3.5v-7H9.5V10h2V6.5z",
};
---
<svg
  class:list={["icone", classe]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
><path d={caminhos[nome]} /></svg>

<style>
  .icone { flex: none; display: block; }
</style>
