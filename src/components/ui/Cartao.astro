---
interface Props {
  variante?: "padrao" | "destaque";
  as?: "div" | "article" | "li";
  class?: string;
}
const { variante = "padrao", as: Tag = "div", class: classe } = Astro.props;
---
<Tag class:list={["cartao", "chanfrado", `cartao--${variante}`, classe]}>
  <slot />
</Tag>

<style>
  .cartao {
    --c: var(--chanfro-lg);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    color: var(--ink);
  }
  .cartao--padrao { --cor-borda: var(--line); --cor-fundo: var(--surface); }
  .cartao--destaque {
    --cor-borda: var(--accent);
    --cor-fundo: var(--surface-raised);
    filter: drop-shadow(0 16px 40px var(--brilho));
  }
  @media (min-width: 720px) { .cartao { padding: var(--s-6); } }
</style>
